%sql
SELECT
  headers['brand']       AS brand,
  headers['product']     AS product,
  headers['messageType'] AS messageType,
  headers['quoteStep']   AS quoteStep,
  COUNT(*)                              AS msg_count,
  COUNT(DISTINCT headers['MQSQuoteId']) AS quote_count,
  MIN(enqueuedTime)                     AS first_seen,
  MAX(enqueuedTime)                     AS last_seen
FROM core_tst.mqs_athn_mtr.ehubstream
GROUP BY 1, 2, 3, 4
ORDER BY brand, product, messageType, quoteStep
