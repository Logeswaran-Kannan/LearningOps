WITH base AS (
    SELECT
        DATE(enqueuedTime) AS enqueue_date,
        headers['messageType'] AS message_type,
        TO_DATE(headers['quoteDate']) AS quote_date
    FROM core.mqs_athn_mtr.ehubstream
    WHERE headers['quoteDate'] IS NOT NULL
)

SELECT
    enqueue_date,
    message_type,
    COUNT(*) AS total_messages,

    SUM(
        CASE
            WHEN DATEDIFF(enqueue_date, quote_date) > 0
            THEN 1 ELSE 0
        END
    ) AS delayed_messages,

    ROUND(
        100.0 * SUM(
            CASE
                WHEN DATEDIFF(enqueue_date, quote_date) > 0
                THEN 1 ELSE 0
            END
        ) / COUNT(*),
        2
    ) AS delayed_pct

FROM base
GROUP BY enqueue_date, message_type
ORDER BY enqueue_date, delayed_messages DESC;

