# ---------------------------------------------------------------------------
# TYPE CLASSIFICATION + VALUE NORMALIZATION (pure SQL-string builders)
# ---------------------------------------------------------------------------
INTEGRAL_TYPES = {"BYTE", "TINYINT", "SHORT", "SMALLINT", "INT", "INTEGER", "LONG", "BIGINT"}
NUMERIC_TYPES = INTEGRAL_TYPES | {"FLOAT", "REAL", "DOUBLE", "DECIMAL", "DEC", "NUMERIC"}
TEMPORAL_TYPES = {"DATE", "TIMESTAMP", "TIMESTAMP_NTZ", "TIMESTAMP_LTZ"}
STRING_TYPES = {"STRING", "VARCHAR", "CHAR"}
BOOLEAN_TYPES = {"BOOLEAN"}
BINARY_TYPES = {"BINARY"}
COMPLEX_TYPES = {"ARRAY", "MAP", "STRUCT"}


def q(name):
    return "`" + name.replace("`", "``") + "`"


def esc(s):
    return s.replace("\\", "\\\\").replace("'", "\\'")


def base_type(dt):
    return re.split(r"[(<\s]", (dt or "").strip().upper())[0]


def type_class(bt):
    if bt in NUMERIC_TYPES:
        return "NUMERIC"
    if bt in TEMPORAL_TYPES:
        return "TEMPORAL"
    if bt in STRING_TYPES:
        return "STRING"
    if bt in BOOLEAN_TYPES:
        return "BOOLEAN"
    if bt in BINARY_TYPES:
        return "BINARY"
    if bt in COMPLEX_TYPES:
        return "COMPLEX"
    return "OTHER"


def pair_category(c1, c2):
    if c1 == c2:
        return c1 if c1 != "OTHER" else "GENERIC"
    pair = {c1, c2}
    if pair == {"NUMERIC", "STRING"}:
        return "NUMERIC_STRING"
    if pair == {"TEMPORAL", "STRING"}:
        return "TEMPORAL_STRING"
    # BOOLEAN vs NUMERIC/STRING (e.g. source 'N' vs target 0, or true vs 1) is
    # deliberately NOT normalized: it falls through to GENERIC (raw text compare)
    # so it is reported as a real difference.
    return "GENERIC"


def _str_norm(c):
    e = f"TRIM(CAST({c} AS STRING))" if TRIM_STRINGS else f"CAST({c} AS STRING)"
    if EMPTY_STRING_AS_NULL:
        e = f"NULLIF({e}, '')"
    if CASE_INSENSITIVE_STRINGS:
        e = f"LOWER({e})"
    return e


def _dec(src):
    return f"try_cast({src} AS DECIMAL(38,{NUMERIC_SCALE}))"


def _num_canon(c, bt, from_string):
    if from_string:
        src, fallback = f"TRIM({c})", _str_norm(c)
    else:
        # FLOAT -> via its shortest string so 0.1f is 0.1, not 0.10000000149
        src = f"CAST({c} AS STRING)" if bt in ("FLOAT", "REAL") else c
        fallback = f"CAST({c} AS STRING)"
    return f"COALESCE(CAST({_dec(src)} AS STRING), {fallback})"


def _ts_canon(c, from_string):
    src = f"TRIM({c})" if from_string else c
    fallback = _str_norm(c) if from_string else f"CAST({c} AS STRING)"
    return f"COALESCE(date_format(try_cast({src} AS TIMESTAMP), '{TIMESTAMP_FORMAT}'), {fallback})"


def _bool01(c):
    return f"CASE WHEN {c} IS NULL THEN NULL WHEN {c} THEN '1' ELSE '0' END"


def norm_expr(col, bt, category):
    """SQL expression -> canonical STRING (or NULL) for one column on one side."""
    c = q(col)
    tc = type_class(bt)
    if category == "NUMERIC":
        return _num_canon(c, bt, False)
    if category == "TEMPORAL":
        return _ts_canon(c, False)
    if category == "STRING":
        return _str_norm(c)
    if category == "BOOLEAN":
        return _bool01(c)
    if category == "BINARY":
        return f"HEX({c})"
    if category == "COMPLEX":
        return f"to_json({c})"
    if category == "NUMERIC_STRING":
        return _num_canon(c, bt, tc == "STRING")
    if category == "TEMPORAL_STRING":
        return _ts_canon(c, tc == "STRING")
    return f"CAST({c} AS STRING)"


def row_hash_sql(norm_exprs):
    if not norm_exprs:
        return "xxhash64('')"
    parts = ", ".join(f"COALESCE({e}, '{NULL_TOKEN}')" for e in norm_exprs)
    return f"xxhash64(CONCAT_WS('{SEP}', {parts}))"


def key_exprs(id_s, bt_s, id_t, bt_t):
    """(src_expr, tgt_expr, kind) so ids compare correctly across types."""
    cs, ct = q(id_s), q(id_t)
    if bt_s in INTEGRAL_TYPES and bt_t in INTEGRAL_TYPES:
        return f"CAST({cs} AS BIGINT)", f"CAST({ct} AS BIGINT)", "BIGINT"
    if bt_s in NUMERIC_TYPES and bt_t in NUMERIC_TYPES:
        return (f"CAST({_dec(cs)} AS STRING)", f"CAST({_dec(ct)} AS STRING)", "STRING")
    return f"CAST({cs} AS STRING)", f"CAST({ct} AS STRING)", "STRING"


