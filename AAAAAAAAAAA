%sql
WITH missing AS (
  SELECT DISTINCT trim(c.mqsQuoteId) AS id
  FROM core_bld.radar_live.reconciliation_csv_source c
  LEFT JOIN core_tst.mqs_athn_mtr.ehubstream e
    ON trim(c.mqsQuoteId) = trim(e.headers['MQSQuoteId'])
   AND cast(e.enqueuedTime AS date) = '2026-09-21'
   AND e.headers['messageType'] = 'mqs-quote-request'
  WHERE e.headers['MQSQuoteId'] IS NULL
    AND c.mqsQuoteId IS NOT NULL
)
SELECT
  cast(e.enqueuedTime AS date)  AS ehub_date,
  e.headers['messageType']      AS messageType,
  e.headers['brand']            AS brand,
  count(DISTINCT m.id)          AS quote_count
FROM missing m
LEFT JOIN core_tst.mqs_athn_mtr.ehubstream e
  ON m.id = trim(e.headers['MQSQuoteId'])
GROUP BY 1, 2, 3
ORDER BY quote_count DESC;
