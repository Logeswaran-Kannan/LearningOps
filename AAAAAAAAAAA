# Databricks notebook source
"""
Silver table reconciliation:  core (read replica)  vs  core_tst_std001 (CDA)
=============================================================================

INPUT (widgets or key=value job args)
  table_name       schema.table  (comma-separated list allowed)  e.g. silver.customer,silver.orders
  key_columns      optional business key(s), comma-separated  -> enables exact per-column mismatch counts
  exclude_columns  optional columns to ignore (e.g. load_ts, etl_batch_id that differ every refresh)
  sample_rows      number of sample mismatch records to store (default 20)

WHAT IS CHECKED (built for big daily full-refresh tables: one scan per side, hashes only are cached)
  1. EXISTENCE  both tables readable
  2. SCHEMA     missing columns each side, data-type differences, nullability, name-case, column order
  3. COUNT      row counts
  4. DATA       full-record comparison of every row on all common columns via SHA-256 row hashes
                (multiset compare, so duplicates are handled), done twice:
                  - STRICT     : raw values cast to string
                  - NORMALISED : trim, blank->NULL, numbers to fixed scale, dates/timestamps to one
                                 format, booleans to true/false, string<->typed columns parsed
                rows that match only after normalisation  = FORMAT issues
                rows that don't match even after it       = DATA issues
                Explicitly reports "all records matched but one side has extra rows".
  5. FORMAT     per-column format differences (exact counts with key_columns, sample-based without)
  6. KEY        (with key_columns) src-only / tgt-only keys, duplicate keys, per-column value mismatches
  7. PROFILE    per-column NULL and blank-string counts each side (catches blank vs NULL issues)

OUTPUT (Delta tables, appended per run, created if missing)
  <OUT_SCHEMA>.recon_summary        one row per table per run, overall status + full comments
  <OUT_SCHEMA>.recon_check_results  one row per check / per column issue with detailed comments
  <OUT_SCHEMA>.recon_mismatch_samples  sample records (full JSON) that failed to match
"""

import json
import time
import traceback
import uuid
from datetime import datetime
from functools import reduce

from pyspark.sql import SparkSession, functions as F, types as T
from pyspark.storagelevel import StorageLevel

spark = SparkSession.builder.getOrCreate()

# ================================ CONFIG ================================
SRC_PREFIX = "core"                        # read replica -> core.<schema>.<table>
TGT_PREFIX = "core_tst_std001"             # CDA          -> core_tst_std001.<schema>.<table>
OUT_SCHEMA = "core_tst_std001.testing_sb"  # results location
TABLE_FORMAT = "DELTA"

NUM_SCALE = 6            # numbers compared rounded to this many decimals after normalisation
RUN_PROFILE = True       # NULL / blank counts per column (one extra aggregate scan per side)
# string -> timestamp parse attempts when one side holds dates as strings (first match wins)
TS_FORMATS = [
    "yyyy-MM-dd HH:mm:ss.SSSSSS", "yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd'T'HH:mm:ss",
    "yyyy-MM-dd", "dd/MM/yyyy HH:mm:ss", "dd/MM/yyyy", "dd-MM-yyyy", "yyyyMMdd",
]
NULL_TOKEN = "<<NULL>>"
SEP = "\u0001"
# ========================================================================

SEVERITY = {"PASS": 0, "INFO": 0, "WARN": 1, "FAIL": 2, "ERROR": 3}


def _params():
    defaults = {"table_name": "", "key_columns": "", "exclude_columns": "", "sample_rows": "20"}
    try:
        for k, v in defaults.items():
            dbutils.widgets.text(k, v)  # noqa: F821  (Databricks)
        return {k: dbutils.widgets.get(k).strip() for k in defaults}  # noqa: F821
    except NameError:  # spark-submit / job: key=value args
        import sys
        args = dict(a.split("=", 1) for a in sys.argv[1:] if "=" in a)
        return {k: args.get(k, v).strip() for k, v in defaults.items()}


def C(name):
    return F.col(f"`{name}`")


def _csv(s):
    return [x.strip().lower() for x in (s or "").split(",") if x.strip()]


# ------------------------------------------------------------ type handling
def kind(dt):
    n = dt.typeName()
    if isinstance(dt, (T.ByteType, T.ShortType, T.IntegerType, T.LongType,
                       T.FloatType, T.DoubleType, T.DecimalType)):
        return "num"
    if n in ("timestamp", "timestamp_ntz"):
        return "ts"
    if n == "date":
        return "date"
    if n == "boolean":
        return "bool"
    if n == "binary":
        return "bin"
    if isinstance(dt, (T.ArrayType, T.MapType, T.StructType)):
        return "complex"
    return "str"


def canonical(k1, k2):
    """Common type both sides are normalised to before comparing."""
    if k1 == k2:
        return k1
    pair = {k1, k2}
    if pair == {"date", "ts"}:
        return "ts"
    if "str" in pair:
        other = (pair - {"str"}).pop()
        if other in ("num", "ts", "date", "bool"):
            return other
    return "str"


def strict_expr(name, k):
    col = C(name)
    if k == "complex":
        v = F.to_json(col)
    elif k == "bin":
        v = F.base64(col)
    else:
        v = col.cast("string")
    return F.coalesce(v, F.lit(NULL_TOKEN))


def norm_expr(name, k, canon):
    q = f"`{name}`"
    if k == "complex":
        as_str = F.to_json(C(name))
    elif k == "bin":
        as_str = F.base64(C(name))
    else:
        as_str = F.trim(C(name).cast("string"))
    blank_null = F.when(as_str == "", F.lit(None)).otherwise(as_str)

    if canon == "num":
        if k == "str":
            d = F.expr(f"try_cast(regexp_replace(trim({q}), ',', '') as decimal(38,{NUM_SCALE}))")
        else:
            d = F.expr(f"try_cast({q} as decimal(38,{NUM_SCALE}))")
        s = F.regexp_replace(F.regexp_replace(d.cast("string"), r"(\.\d*?)0+$", "$1"), r"\.$", "")
        s = F.when(s == "-0", F.lit("0")).otherwise(s)
        v = F.coalesce(s, blank_null)          # unparsable strings still compared as text
    elif canon in ("ts", "date"):
        fmt = "yyyy-MM-dd HH:mm:ss.SSSSSS" if canon == "ts" else "yyyy-MM-dd"
        if k in ("ts", "date"):
            t = C(name).cast("timestamp")
        else:
            t = F.coalesce(*[F.expr(f"try_to_timestamp(trim({q}), '{f}')") for f in TS_FORMATS],
                           F.expr(f"try_cast(trim({q}) as timestamp)"))
        v = F.coalesce(F.date_format(t, fmt), blank_null)
    elif canon == "bool":
        low = F.lower(as_str)
        v = (F.when(low.isin("true", "1", "y", "yes", "t"), F.lit("true"))
              .when(low.isin("false", "0", "n", "no", "f"), F.lit("false"))
              .otherwise(blank_null))
    else:
        v = blank_null
    return F.coalesce(v, F.lit(NULL_TOKEN))


def explain_format(sv, tv):
    """Human-readable guess at why two raw values differ but normalise equal."""
    if sv is None or tv is None:
        return "value differs in representation"
    if NULL_TOKEN in (sv, tv) and (sv.strip() == "" or tv.strip() == ""):
        return "blank string vs NULL"
    if sv.strip() == tv.strip():
        return "leading/trailing whitespace"
    def is_num(x):
        try:
            float(x.replace(",", ""))
            return True
        except ValueError:
            return False
    if is_num(sv) and is_num(tv):
        return "numeric precision/scale or formatting (e.g. 10.5 vs 10.50, thousands separator)"
    if any(ch in sv + tv for ch in "-/:") and any(c.isdigit() for c in sv + tv):
        return "date/timestamp format or precision"
    if sv.lower() in ("true", "false", "1", "0", "y", "n", "yes", "no"):
        return "boolean representation"
    return "value representation differs (type cast)"


