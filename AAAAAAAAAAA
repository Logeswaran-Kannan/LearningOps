def _q(s):
    return str(s).replace("\\", "\\\\").replace("'", "\\'")


def ensure_output_tables():
    """Create output tables; add any new columns to tables created by an older version."""
    for name, (cols, comment) in OUTPUT_TABLES.items():
        fqn = f"{OUT_SCHEMA}.{name}"
        ddl = ", ".join(f"`{c}` {t} COMMENT '{_q(cm)}'" for c, t, cm in cols)
        spark.sql(f"CREATE TABLE IF NOT EXISTS {fqn} ({ddl}) USING DELTA COMMENT '{_q(comment)}'")
        existing = {f.name.lower() for f in spark.table(fqn).schema.fields}
        missing = [c for c in cols if c[0].lower() not in existing]
        if missing:
            spark.sql(f"ALTER TABLE {fqn} ADD COLUMNS ("
                      + ", ".join(f"`{c}` {t} COMMENT '{_q(cm)}'" for c, t, cm in missing) + ")")
    try:
        spark.sql(f"CREATE OR REPLACE VIEW {OUT_SCHEMA}.recon_summary_latest "
                  f"COMMENT 'Latest reconciliation run per table per run_date' AS "
                  f"SELECT * FROM {OUT_SCHEMA}.recon_summary WHERE latest_run_ind = 'Y'")
    except Exception as e:  # view is a convenience only
        print(f"WARNING: could not create view recon_summary_latest: {e}")


def _append(table, rows):
    if not rows:
        return
    schema = spark.table(f"{OUT_SCHEMA}.{table}").schema
    data = [tuple(r.get(f.name) for f in schema.fields) for r in rows]
    spark.createDataFrame(data, schema).write.mode("append").saveAsTable(f"{OUT_SCHEMA}.{table}")


def mark_latest(table_name, run_date, run_id):
    """Only the newest run of a table on a given run_date keeps latest_run_ind = 'Y'."""
    for t in OUTPUT_TABLES:
        spark.sql(f"""UPDATE {OUT_SCHEMA}.{t} SET latest_run_ind = 'N'
                      WHERE table_name = '{_q(table_name)}' AND run_date = DATE'{run_date.isoformat()}'
                        AND run_id <> '{_q(run_id)}' AND (latest_run_ind = 'Y' OR latest_run_ind IS NULL)""")


