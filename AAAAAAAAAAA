def _csv(s):
    return [x.strip().lower() for x in re.split(r"[,;|]", s or "") if x.strip()]


def parse_tables(s, default_keys):
    """'silver.a:k1|k2, silver.b' -> [('silver.a', ['k1','k2']), ('silver.b', default_keys)]"""
    out, seen = [], set()
    for tok in re.split(r"[,;\s]+", s or ""):
        tok = tok.strip()
        if not tok:
            continue
        name, _, keys = tok.partition(":")
        name = name.strip()
        if name.lower() in seen:
            continue
        seen.add(name.lower())
        out.append((name, _csv(keys) if keys else list(default_keys)))
    return out


def _fqn(prefix, table):
    return f"{prefix}.{table}" if prefix else table


def _tz():
    tz = LOCAL_TZ or spark.conf.get("spark.sql.session.timeZone", "UTC")
    try:
        return ZoneInfo(tz) if ZoneInfo else None
    except Exception:
        return None


def _session_tz():
    try:
        return ZoneInfo(spark.conf.get("spark.sql.session.timeZone", "UTC")) if ZoneInfo else None
    except Exception:
        return None


def now_local():
    tz = _tz()
    return datetime.now(tz).replace(tzinfo=None) if tz else datetime.now()


def resolve_window(start, end):
    """Returns (start, end) as naive datetimes in LOCAL_TZ, or None for open ends."""
    s, e = (start or "").strip(), (end or "").strip()
    if "DAILY" in (s.upper(), e.upper()):
        today = now_local().replace(hour=DAILY_CUTOFF_HOUR, minute=0, second=0, microsecond=0)
        return today - timedelta(days=1), today

    def parse(x, name):
        if not x:
            return None
        try:
            return datetime.fromisoformat(x.replace("T", " "))
        except ValueError:
            raise ValueError(f"{name}='{x}' is not valid. Use 'yyyy-MM-dd HH:mm:ss', 'yyyy-MM-dd', DAILY or blank.")

    st, en = parse(s, "filter_start"), parse(e, "filter_end")
    if st and en and st >= en:
        raise ValueError(f"filter_start ({st}) must be before filter_end ({en}).")
    return st, en


def to_session_literal(dt):
    """Convert a LOCAL_TZ wall-clock datetime to the Spark session time zone, as a literal string."""
    src_tz, ses_tz = _tz(), _session_tz()
    if src_tz and ses_tz and LOCAL_TZ:
        dt = dt.replace(tzinfo=src_tz).astimezone(ses_tz).replace(tzinfo=None)
    return dt.strftime("%Y-%m-%d %H:%M:%S")


# ------------------------------------------------------------ type handling
def C(name):
    return F.col(f"`{name}`")


def kind(dt):
    n = dt.typeName()
    if isinstance(dt, (T.ByteType, T.ShortType, T.IntegerType, T.LongType,
                       T.FloatType, T.DoubleType, T.DecimalType)):
        return "num"
    if n in ("timestamp", "timestamp_ntz"):
        return "ts"
    if n == "date":
        return "date"
    if n == "boolean":
        return "bool"
    if n == "binary":
        return "bin"
    if isinstance(dt, (T.ArrayType, T.MapType, T.StructType)):
        return "complex"
    return "str"


def canonical(k1, k2):
    if k1 == k2:
        return k1
    pair = {k1, k2}
    if pair == {"date", "ts"}:
        return "ts"
    if "str" in pair:
        other = (pair - {"str"}).pop()
        if other in ("num", "ts", "date", "bool"):
            return other
    return "str"


def parse_ts_from_string(q):
    return F.coalesce(*[F.expr(f"try_to_timestamp(trim({q}), '{f}')") for f in TS_FORMATS],
                      F.expr(f"try_cast(trim({q}) as timestamp)"))


def strict_expr(name, k):
    col = C(name)
    if k == "complex":
        v = F.to_json(col)
    elif k == "bin":
        v = F.base64(col)
    else:
        v = col.cast("string")
    return F.coalesce(v, F.lit(NULL_TOKEN))


def norm_expr(name, k, canon):
    q = f"`{name}`"
    if k == "complex":
        as_str = F.to_json(C(name))
    elif k == "bin":
        as_str = F.base64(C(name))
    else:
        as_str = F.trim(C(name).cast("string"))
    blank_null = F.when(as_str == "", F.lit(None)).otherwise(as_str)

    if canon == "num":
        if k == "str":
            d = F.expr(f"try_cast(regexp_replace(trim({q}), ',', '') as decimal(38,{NUM_SCALE}))")
        else:
            d = F.expr(f"try_cast({q} as decimal(38,{NUM_SCALE}))")
        s = F.regexp_replace(F.regexp_replace(d.cast("string"), r"(\.\d*?)0+$", "$1"), r"\.$", "")
        s = F.when(s == "-0", F.lit("0")).otherwise(s)
        v = F.coalesce(s, blank_null)
    elif canon in ("ts", "date"):
        fmt = "yyyy-MM-dd HH:mm:ss.SSSSSS" if canon == "ts" else "yyyy-MM-dd"
        t = C(name).cast("timestamp") if k in ("ts", "date") else parse_ts_from_string(q)
        v = F.coalesce(F.date_format(t, fmt), blank_null)
    elif canon == "bool":
        low = F.lower(as_str)
        v = (F.when(low.isin("true", "1", "y", "yes", "t"), F.lit("true"))
              .when(low.isin("false", "0", "n", "no", "f"), F.lit("false"))
              .otherwise(blank_null))
    else:
        v = blank_null
    return F.coalesce(v, F.lit(NULL_TOKEN))


def h64(cols, salted=False):
    return F.xxhash64(F.lit(HASH_SALT), *cols) if salted else F.xxhash64(*cols)


def dsum(c):
    return F.sum(F.col(c).cast("decimal(20,0)"))


def explain_format(sv, tv):
    if sv is None or tv is None:
        return "value differs in representation"
    if NULL_TOKEN in (sv, tv) and (sv.strip() == "" or tv.strip() == ""):
        return "blank string vs NULL"
    if sv.strip() == tv.strip():
        return "leading/trailing whitespace"

    def is_num(x):
        try:
            float(x.replace(",", ""))
            return True
        except ValueError:
            return False
    if is_num(sv) and is_num(tv):
        return "numeric precision/scale or formatting (e.g. 10.5 vs 10.50, thousands separator)"
    if any(ch in sv + tv for ch in "-/:") and any(c.isdigit() for c in sv + tv):
        return "date/timestamp format or precision"
    if sv.lower() in ("true", "false", "1", "0", "y", "n", "yes", "no"):
        return "boolean representation"
    return "value representation differs (type cast)"


# ------------------------------------------------------------ reconciliation
class Recon:
    def __init__(self, table, keys, excl, filter_col, f_start, f_end, sample_rows, run, win=None, seq=None):
        self.table, self.keys, self.excl = table, keys, excl
        self.win = win or {"mode": "FIXED"}
        self.filter_col = filter_col.lower() if filter_col else ""
        self.f_start, self.f_end, self.n = f_start, f_end, sample_rows
        self.run_id, self.run_ts, self.run_date = run["run_id"], run["run_ts"], run["run_date"]
        self.src_fqn, self.tgt_fqn = _fqn(SRC_PREFIX, table), _fqn(TGT_PREFIX, table)
        self.results, self.samples, self.comments = [], [], []
        self.special_status = None
        self.src_p = self.tgt_p = None
        self.drill, self.clean_cnt, self.fmt_rows = None, 0, 0
        self.summary = dict(self._base(), run_seq=seq, src_table=self.src_fqn, tgt_table=self.tgt_fqn,
                            key_columns=",".join(keys), excluded_columns=",".join(sorted(excl)).upper(),
                            filter_column=filter_col, filter_start=f_start, filter_end=f_end,
                            filter_applied="N", filter_mode=self.win["mode"])

    def _base(self):
        return dict(run_id=self.run_id, run_ts=self.run_ts, run_date=self.run_date,
                    latest_run_ind="Y", table_name=self.table)

    def add(self, category, check, status, comments, column=None, src_value=None, tgt_value=None,
            diff=None, sample_src=None, sample_tgt=None, note=False):
        self.results.append(dict(
            self._base(), src_table=self.src_fqn, tgt_table=self.tgt_fqn, check_category=category,
            check_name=check, column_name=column, status=status,
            src_value=None if src_value is None else str(src_value),
            tgt_value=None if tgt_value is None else str(tgt_value),
            diff_count=None if diff is None else int(diff), comments=comments,
            sample_src=None if sample_src is None else str(sample_src)[:4000],
            sample_tgt=None if sample_tgt is None else str(sample_tgt)[:4000]))
        if status in ("WARN", "FAIL", "ERROR") or note:
            self.comments.append(f"[{category}/{status}] {comments}")

    def add_sample(self, sample_type, side, rec, pair_id=None):
        self.samples.append(dict(self._base(), sample_type=sample_type, side=side,
                                 pair_id=pair_id, record_json=rec))

    def guard(self, category, step, fn, *args):
        """Run one step; on failure log ERROR and let the remaining steps continue."""
        try:
            return fn(*args)
        except Exception as e:
            self.add(category, f"{step}_error", "ERROR",
                     f"Step '{step}' failed and was skipped, other checks continued: "
                     f"{type(e).__name__}: {str(e)[:1200]}",
                     sample_src=traceback.format_exc()[-3000:])
            return None

    # -------------------------------------------------- run
    def run(self):
        t0 = time.time()
        try:
            self._run()
        except Exception as e:
            self.add("DATA", "execution_error", "ERROR",
                     f"Reconciliation aborted: {type(e).__name__}: {str(e)[:1200]}",
                     sample_src=traceback.format_exc()[-3000:])
        finally:
            for df in (self.src_p, self.tgt_p):
                if df is not None:
                    try:
                        df.unpersist()
                    except Exception:
                        pass

        for col, cats in STATUS_GROUPS.items():
            sev = [SEVERITY[r["status"]] for r in self.results if r["check_category"] in cats]
            self.summary[col] = SEV_NAME[max(sev)] if sev else "NOT_RUN"
        worst = max((SEVERITY[r["status"]] for r in self.results), default=0)
        overall = {0: "PASS", 1: "PASS_WITH_WARNINGS", 2: "FAIL", 3: "ERROR"}[worst]
        if self.special_status and worst <= 1:
            overall = self.special_status
        self.summary.update(
            overall_status=overall,
            comments=" | ".join(self.comments) if self.comments
            else "All checks passed: schema, counts and full-record data match.",
            duration_sec=round(time.time() - t0, 1))
        with _WRITE_LOCK:  # Delta writes serialised across parallel tables
            _append("recon_summary", [self.summary])
            _append("recon_check_results", self.results)
            _append("recon_mismatch_samples", self.samples)
            mark_latest(self.table, self.run_date, self.run_id)
        return overall

    @staticmethod
    def _read(fqn):
        df = spark.table(fqn)
        _ = df.schema  # force analysis now (Spark Connect / serverless resolves tables lazily)
        return df

    def _run(self):
        src = self.guard("EXISTENCE", "read_source", self._read, self.src_fqn)
        tgt = self.guard("EXISTENCE", "read_target", self._read, self.tgt_fqn)
        if src is None or tgt is None:
            missing = [f for f, d in ((self.src_fqn, src), (self.tgt_fqn, tgt)) if d is None]
            self.add("EXISTENCE", "table_not_readable", "ERROR",
                     f"Table(s) not found or not readable: {', '.join(missing)}. Check name/suffix "
                     f"(e.g. _SAT vs _BSAT) and permissions.")
            return
        if not self.guard("SCHEMA", "schema_compare", self._schema, src, tgt):
            return
        filtered = self.guard("FILTER", "filter", self._filter, src, tgt)
        if filtered:
            src, tgt = filtered
        self.src, self.tgt = src, tgt
        self.guard("DATA", "data_compare", self._data_compare)

    # -------------------------------------------------- schema (handles added / removed columns)
    def _schema(self, src, tgt):
        s_map = {f.name.lower(): f for f in src.schema.fields}
        t_map = {f.name.lower(): f for f in tgt.schema.fields}
        self.s_map, self.t_map = s_map, t_map
        excl_present = sorted({c for c in self.excl if c in s_map or c in t_map})
        if excl_present:
            self.add("SCHEMA", "excluded_columns", "INFO",
                     f"Excluded from comparison: {', '.join(c.upper() for c in excl_present)}.")
        miss_tgt = [c for c in s_map if c not in t_map and c not in self.excl]
        miss_src = [c for c in t_map if c not in s_map and c not in self.excl]
        self.common = [c for c in s_map if c in t_map and c not in self.excl]
        self.s_names = {c: s_map[c].name for c in self.common}
        self.t_names = {c: t_map[c].name for c in self.common}
        self.s_kinds = {c: kind(s_map[c].dataType) for c in self.common}
        self.t_kinds = {c: kind(t_map[c].dataType) for c in self.common}
        self.canon = {c: canonical(self.s_kinds[c], self.t_kinds[c]) for c in self.common}
        n_common = len(self.common)

        def rename_hint(col, own, other_missing, other_map):
            same = [other_map[o].name for o in other_missing
                    if other_map[o].dataType.simpleString() == own[col].dataType.simpleString()]
            return f" Possible rename to/from: {', '.join(same[:5])}." if same else ""

        for c in miss_tgt:
            dt = s_map[c].dataType.simpleString()
            self.add("SCHEMA", "column_removed_in_target", SCHEMA_DRIFT_STATUS,
                     f"Column '{s_map[c].name}' ({dt}) exists in source but NOT in target "
                     f"(removed in target / not yet added). Skipped; data compared on the {n_common} "
                     f"common columns.{rename_hint(c, s_map, miss_src, t_map)}",
                     column=s_map[c].name, src_value=dt, tgt_value="<missing>")
        for c in miss_src:
            dt = t_map[c].dataType.simpleString()
            self.add("SCHEMA", "column_added_in_target", SCHEMA_DRIFT_STATUS,
                     f"Column '{t_map[c].name}' ({dt}) exists in target but NOT in source "
                     f"(added in target / removed in source). Skipped; data compared on the {n_common} "
                     f"common columns.{rename_hint(c, t_map, miss_tgt, s_map)}",
                     column=t_map[c].name, src_value="<missing>", tgt_value=dt)

        type_mm = []
        for c in self.common:
            st, tt = s_map[c].dataType.simpleString(), t_map[c].dataType.simpleString()
            if st != tt:
                type_mm.append(c)
                self.add("SCHEMA", "data_type_mismatch", "WARN",
                         f"Data type differs for '{self.s_names[c]}': source {st} vs target {tt}. Values "
                         f"compared after normalising both to '{self.canon[c]}'; see FORMAT/DATA results.",
                         column=self.s_names[c], src_value=st, tgt_value=tt)
            if s_map[c].nullable != t_map[c].nullable:
                self.add("SCHEMA", "nullability_mismatch", "INFO",
                         f"Nullability differs for '{self.s_names[c]}': source nullable={s_map[c].nullable}, "
                         f"target nullable={t_map[c].nullable}.", column=self.s_names[c],
                         src_value=s_map[c].nullable, tgt_value=t_map[c].nullable)
            if self.s_names[c] != self.t_names[c]:
                self.add("SCHEMA", "column_name_case_mismatch", "INFO",
                         f"Column name case differs: source '{self.s_names[c]}' vs target '{self.t_names[c]}'.",
                         column=self.s_names[c], src_value=self.s_names[c], tgt_value=self.t_names[c])
        if [c for c in s_map if c in t_map] != [c for c in t_map if c in s_map]:
            self.add("SCHEMA", "column_order", "INFO",
                     "Common columns are in a different order (no impact on this comparison).")
        if not (miss_tgt or miss_src or type_mm):
            self.add("SCHEMA", "schema_comparison", "PASS",
                     f"{n_common} compared columns have identical names and data types.")

        self.summary.update(
            src_column_count=len(s_map), tgt_column_count=len(t_map), common_column_count=n_common,
            cols_missing_in_tgt=",".join(s_map[c].name for c in miss_tgt) or None,
            cols_missing_in_src=",".join(t_map[c].name for c in miss_src) or None,
            type_mismatch_cols=",".join(self.s_names[c] for c in type_mm) or None)

        if not self.common:
            self.add("SCHEMA", "common_columns", "ERROR",
                     "No common columns after exclusions - data cannot be compared.")
            return False
        bad = [k for k in self.keys if k not in self.common]
        if bad:
            self.add("KEY", "key_columns_valid", "WARN",
                     f"Key column(s) {', '.join(bad)} not present in both tables (or excluded); key checks "
                     f"and duplicate-key checks skipped, full-record comparison still performed.")
            self.keys = []
        self.summary["key_columns"] = ",".join(self.keys) or None
        return True

    # -------------------------------------------------- SYS_EFCTV_DT window
    @staticmethod
    def _filter_col_expr(fld):
        k = kind(fld.dataType)
        return parse_ts_from_string(f"`{fld.name}`") if k == "str" else C(fld.name)

    def _cond(self, fld, lo, hi, lo_incl, hi_incl):
        """lo/hi are literal strings already in the Spark session time zone."""
        k = kind(fld.dataType)
        col = self._filter_col_expr(fld)

        def lit(v):
            return F.to_date(F.lit(v)) if k == "date" else F.to_timestamp(F.lit(v))
        cond = F.lit(True)
        if lo is not None:
            cond = cond & ((col >= lit(lo)) if lo_incl else (col > lit(lo)))
        if hi is not None:
            cond = cond & ((col <= lit(hi)) if hi_incl else (col < lit(hi)))
        return cond

    def _cutoff_window(self, src, tgt, s_fld, t_fld, name):
        """MAX_CUTOFF: cutoff = max(filter col) from SOURCE / TARGET / MIN of both,
        window = (cutoff - WINDOW_HOURS, cutoff] applied identically to both sides."""
        fmt, pyfmt = "yyyy-MM-dd HH:mm:ss.SSSSSS", "%Y-%m-%d %H:%M:%S.%f"

        def col_max(df, fld):  # formatted in session TZ so it round-trips exactly into the filter
            col = self._filter_col_expr(fld).cast("timestamp")
            return df.agg(F.date_format(F.max(col), fmt).alias("m")).first()["m"]

        s_max, t_max = col_max(src, s_fld), col_max(tgt, t_fld)
        self.summary.update(src_max_filter_value=s_max, tgt_max_filter_value=t_max)
        frm = self.win["cutoff_from"]
        cutoff = {"SOURCE": s_max, "TARGET": t_max,
                  "MIN": min(s_max, t_max) if s_max and t_max else None}[frm]
        if cutoff is None:
            self.add("FILTER", "cutoff_not_found", "WARN",
                     f"MAX_CUTOFF: no non-NULL {name} found (source max={s_max}, target max={t_max}, "
                     f"CUTOFF_FROM={frm}); WHOLE data compared on both sides.", note=True)
            return None

        if s_max and t_max and s_max != t_max:
            gap = abs((datetime.strptime(s_max, pyfmt) - datetime.strptime(t_max, pyfmt)).total_seconds()) / 60
            behind = "CDA (target)" if t_max < s_max else "RR (source)"
            msg = (f"Max {name}: RR {s_max} vs CDA {t_max} - {behind} is {gap:,.1f} min behind. "
                   f"Cutoff taken from {frm} = {cutoff}.")
            lagging_inside = (frm == "SOURCE" and t_max < s_max) or (frm == "TARGET" and s_max < t_max)
            if lagging_inside:
                msg += (" Rows of the lagging side between its max and the cutoff are not loaded yet and will "
                        "show as unmatched; set CUTOFF_FROM='MIN' to exclude that gap.")
            self.add("FILTER", "load_lag", "WARN" if lagging_inside else "INFO", msg,
                     src_value=s_max, tgt_value=t_max, note=True)

        hours = float(self.win["hours"] or 0)
        lo = ((datetime.strptime(cutoff, pyfmt) - timedelta(hours=hours)).strftime(pyfmt)
              if hours > 0 else None)
        self.summary["filter_start"] = datetime.strptime(lo, pyfmt) if lo else None
        self.summary["filter_end"] = datetime.strptime(cutoff, pyfmt)
        desc = (f"({lo or '-inf'} , {cutoff}] = {hours:g}h back from max {name} of {frm}"
                + (" (DATE column: whole days)" if kind(s_fld.dataType) == "date" else ""))
        return lo, cutoff, False, True, desc

    def _filter(self, src, tgt):
        name = self.filter_col.upper() or "<none>"
        dynamic = self.win["mode"] == "MAX_CUTOFF"
        if not dynamic and self.f_start is None and self.f_end is None:
            self.add("FILTER", "filter_window", "INFO",
                     "No filter_start / filter_end supplied - whole data compared.", note=True)
            return src, tgt
        in_s, in_t = self.filter_col in self.s_map, self.filter_col in self.t_map
        if not (in_s and in_t):
            where = "either table" if not (in_s or in_t) else ("target" if in_s else "source")
            self.add("FILTER", "filter_column_missing", "INFO" if not (in_s or in_t) else "WARN",
                     f"Filter column {name} not present in {where}; WHOLE data compared on both sides.", note=True)
            return src, tgt
        s_fld, t_fld = self.s_map[self.filter_col], self.t_map[self.filter_col]
        for side, fld in (("source", s_fld), ("target", t_fld)):
            if kind(fld.dataType) not in ("ts", "date", "str"):
                self.add("FILTER", "filter_column_type", "WARN",
                         f"Filter column {name} in {side} is {fld.dataType.simpleString()} (not date/timestamp); "
                         f"WHOLE data compared on both sides.", note=True)
                return src, tgt

        if dynamic:
            win = self._cutoff_window(src, tgt, s_fld, t_fld, name)
            if win is None:
                return src, tgt
            lo, hi, lo_incl, hi_incl, desc = win
        else:
            lo = to_session_literal(self.f_start) if self.f_start else None
            hi = to_session_literal(self.f_end) if self.f_end else None
            lo_incl, hi_incl = True, False
            desc = f"[{self.f_start or '-inf'} , {self.f_end or '+inf'})"

        self.summary["filter_applied"] = "Y"
        self.add("FILTER", "filter_window", "PASS",
                 f"Both sides filtered on {name} {desc}; rows with NULL {name} excluded.")
        self.comments.append(f"[FILTER] {name} window {desc} applied to both sides")
        return (src.where(self._cond(s_fld, lo, hi, lo_incl, hi_incl)),
                tgt.where(self._cond(t_fld, lo, hi, lo_incl, hi_incl)))

    # -------------------------------------------------- hash expressions
    def proj(self, df, names, kinds):
        """Compact per-row projection: 4 x 64-bit row hashes (+ key hash) + bucket."""
        n = len(self.common)
        base = df.select(
            *[strict_expr(names[c], kinds[c]).alias(f"_s{i}") for i, c in enumerate(self.common)],
            *[norm_expr(names[c], kinds[c], self.canon[c]).alias(f"_n{i}") for i, c in enumerate(self.common)])
        s = [F.col(f"_s{i}") for i in range(n)]
        nn = [F.col(f"_n{i}") for i in range(n)]
        out = [h64(s).alias("sh1"), h64(s, True).alias("sh2"), h64(nn).alias("nh1"), h64(nn, True).alias("nh2")]
        if self.keys:
            out.append(F.xxhash64(*[F.col(f"_n{self.common.index(k)}") for k in self.keys]).alias("kh"))
        return base.select(*out).withColumn(
            "b", F.pmod(F.col("kh" if self.keys else "nh1"), F.lit(NUM_BUCKETS)))

    def raw_nh1(self, names, kinds):
        return F.xxhash64(*[norm_expr(names[c], kinds[c], self.canon[c]) for c in self.common])

    def raw_sh1(self, names, kinds):
        return F.xxhash64(*[strict_expr(names[c], kinds[c]) for c in self.common])

    def raw_kh(self, names, kinds):
        return F.xxhash64(*[norm_expr(names[k], kinds[k], self.canon[k]) for k in self.keys])

    def raw_drill(self, df, names, kinds):
        """Raw rows that fall in the differing buckets (same bucket formula as proj)."""
        if self.drill is None:
            return df
        h = self.raw_kh(names, kinds) if self.keys else self.raw_nh1(names, kinds)
        return df.where(F.pmod(h, F.lit(NUM_BUCKETS)).isin(self.drill))

    def fetch(self, df, names, kinds, hash_expr, hashes):
        """{hash: (raw_json, {col: strict value})} for rows whose hash_expr is in hashes."""
        hashes = [int(h) for h in hashes if h is not None]
        if not hashes:
            return {}
        raw = F.to_json(F.struct(*[C(x) for x in df.columns]))
        smap = F.to_json(F.create_map(*[x for c in self.common
                                        for x in (F.lit(c), strict_expr(names[c], kinds[c]))]))
        rows = (df.select(hash_expr.alias("_h"), raw.alias("_raw"), smap.alias("_smap"))
                  .where(F.col("_h").isin(hashes)).limit(len(hashes) * 3).collect())
        out = {}
        for r in rows:
            out.setdefault(r["_h"], (r["_raw"], json.loads(r["_smap"])))
        return out

    @staticmethod
    def hash_diff(sp, tp, cols):
        s = sp.groupBy(*cols).agg(F.count(F.lit(1)).alias("s_cnt"))
        t = tp.groupBy(*cols).agg(F.count(F.lit(1)).alias("t_cnt"))
        j = s.join(t, list(cols), "full_outer").fillna(0, subset=["s_cnt", "t_cnt"])
        r = j.agg(
            F.sum(F.least("s_cnt", "t_cnt")).alias("matched"),
            F.sum(F.greatest(F.col("s_cnt") - F.col("t_cnt"), F.lit(0))).alias("src_only"),
            F.sum(F.greatest(F.col("t_cnt") - F.col("s_cnt"), F.lit(0))).alias("tgt_only"),
        ).first()
        return {k: int(v or 0) for k, v in r.asDict().items()}, j

    # -------------------------------------------------- data comparison (tiered)
    def _data_compare(self):
        lvl = StorageLevel.MEMORY_AND_DISK
        self.src_p = self.proj(self.src, self.s_names, self.s_kinds).persist(lvl)
        self.tgt_p = self.proj(self.tgt, self.t_names, self.t_kinds).persist(lvl)

        # ---- tier 1: fingerprint (also materialises the cache: one scan per side)
        def fp(P):
            return P.agg(F.count(F.lit(1)).alias("cnt"), *[dsum(h).alias(h) for h in HCOLS]).first().asDict()
        fs, ft = fp(self.src_p), fp(self.tgt_p)
        sc, tc = int(fs["cnt"]), int(ft["cnt"])
        self.summary.update(src_count=sc, tgt_count=tc, count_diff=tc - sc)
        exact_eq = sc == tc and fs["sh1"] == ft["sh1"] and fs["sh2"] == ft["sh2"]
        ncols = len(self.common)

        # ---- tier 2: duplicates (always, from cached hashes)
        if CHECK_DUPLICATES:
            self.guard("DATA", "duplicate_check", self._dups)

        if exact_eq:
            self.summary.update(compare_method="FINGERPRINT_MATCH", exact_matched_rows=sc, matched_rows=sc,
                                format_only_rows=0, src_only_rows=0, tgt_only_rows=0)
            if self.keys:
                self.summary.update(key_matched=sc, key_src_only=0, key_tgt_only=0, key_rows_all_cols_match=sc)
            self.add("COUNT", "row_count", "PASS", f"Row counts match ({sc:,}).", src_value=sc, tgt_value=tc, diff=0)
            if sc == 0:
                self.add("DATA", "full_record_match", "WARN",
                         "Both sides have 0 rows for the compared window - nothing to compare.")
            else:
                self.add("DATA", "full_record_match", "PASS",
                         f"All {sc:,} records identical on all {ncols} compared columns (whole-table 128-bit "
                         f"fingerprint match; no drill-down needed).", src_value=sc, tgt_value=tc, diff=0)
            return True

        # ---- tier 3: localise differing buckets
        self.drill = self._locate()

        # ---- tier 4: detailed comparison on differing buckets only
        if self.drill is None:
            self.sp, self.tp = self.src_p, self.tgt_p
        else:
            self.sp = self.src_p.where(F.col("b").isin(self.drill))
            self.tp = self.tgt_p.where(F.col("b").isin(self.drill))
        st, _ = self.hash_diff(self.sp, self.tp, ["sh1", "sh2"])
        nm, self.nm_j = self.hash_diff(self.sp, self.tp, ["nh1", "nh2"])
        self.nm = nm
        self.fmt_rows = nm["matched"] - st["matched"]
        matched, exact = nm["matched"] + self.clean_cnt, st["matched"] + self.clean_cnt
        self.summary.update(exact_matched_rows=exact, matched_rows=matched, format_only_rows=self.fmt_rows,
                            src_only_rows=nm["src_only"], tgt_only_rows=nm["tgt_only"])

        if sc == tc:
            self.add("COUNT", "row_count", "PASS", f"Row counts match ({sc:,}).",
                     src_value=sc, tgt_value=tc, diff=0)
        else:
            more, side_more = (tc - sc, "Target") if tc > sc else (sc - tc, "Source")
            one_sided = (nm["src_only"] == 0) if tc > sc else (nm["tgt_only"] == 0)
            self.add("COUNT", "row_count", "WARN" if one_sided else "FAIL",
                     f"{side_more} has {more:,} more rows (source {sc:,} vs target {tc:,})."
                     + (f" All rows of the smaller side matched; difference is purely extra rows in "
                        f"{side_more.lower()}." if one_sided else " Mismatches exist in both directions."),
                     src_value=sc, tgt_value=tc, diff=tc - sc)

        if nm["src_only"] == 0 and nm["tgt_only"] == 0:
            self.add("DATA", "full_record_match", "PASS",
                     f"All {matched:,} records match on all {ncols} compared columns after format normalisation.",
                     src_value=sc, tgt_value=tc, diff=0)
        elif nm["src_only"] == 0:
            self.special_status = "MATCHED_WITH_EXTRA_ROWS_IN_TARGET"
            self.add("DATA", "full_record_match", "WARN",
                     f"All {sc:,} source records are present in target (full-record match on {ncols} "
                     f"columns) but target has {nm['tgt_only']:,} EXTRA record(s) not in source. "
                     f"See recon_mismatch_samples (TGT_ONLY).",
                     src_value=matched, tgt_value=tc, diff=nm["tgt_only"])
        elif nm["tgt_only"] == 0:
            self.special_status = "MATCHED_WITH_EXTRA_ROWS_IN_SOURCE"
            self.add("DATA", "full_record_match", "WARN",
                     f"All {tc:,} target records are present in source (full-record match on {ncols} "
                     f"columns) but source has {nm['src_only']:,} record(s) NOT loaded to target. "
                     f"See recon_mismatch_samples (SRC_ONLY).",
                     src_value=sc, tgt_value=matched, diff=nm["src_only"])
        else:
            self.add("DATA", "full_record_match", "FAIL",
                     f"{matched:,} records matched; {nm['src_only']:,} source records have no full-record "
                     f"match in target and {nm['tgt_only']:,} target records have no match in source "
                     f"(after format normalisation). "
                     + ("See KEY/DATA column results for the columns responsible." if self.keys
                        else "Give a key (schema.table:key) to see which columns differ."),
                     src_value=nm["src_only"], tgt_value=nm["tgt_only"],
                     diff=nm["src_only"] + nm["tgt_only"])
        if self.fmt_rows > 0:
            self.add("FORMAT", "format_only_rows", "WARN",
                     f"{self.fmt_rows:,} records match only after normalisation (whitespace, blank vs NULL, "
                     f"numeric scale, date/timestamp format or type cast). Column detail in FORMAT results.",
                     diff=self.fmt_rows)

        self.src_d = self.raw_drill(self.src, self.s_names, self.s_kinds)
        self.tgt_d = self.raw_drill(self.tgt, self.t_names, self.t_kinds)
        self.guard("DATA", "unmatched_samples", self._samples)
        if self.keys:
            self.guard("KEY", "key_compare", self._keyed)
        elif self.fmt_rows > 0:
            self.guard("FORMAT", "format_detail", self._format_detail_no_key)
        if RUN_PROFILE:
            self.guard("PROFILE", "profile", self._profile)
        return True

    def _locate(self):
        """Compare per-bucket counts/checksums; return differing bucket ids (None = drill everything)."""
        def stats(P, p):
            return P.groupBy("b").agg(F.count(F.lit(1)).alias(f"{p}c"), *[dsum(h).alias(f"{p}{h}") for h in HCOLS])
        j = stats(self.src_p, "s").join(stats(self.tgt_p, "t"), "b", "full_outer")
        clean = reduce(lambda a, b: a & b,
                       [F.col(f"s{c}").eqNullSafe(F.col(f"t{c}")) for c in ("c", "sh1", "sh2")])
        r = j.agg(F.sum(F.when(clean, F.col("sc")).otherwise(0)).alias("clean_rows"),
                  F.sum(F.when(~clean, 1).otherwise(0)).alias("bad_b"),
                  F.sum(F.when(~clean, F.coalesce(F.col("sc"), F.lit(0))).otherwise(0)).alias("bad_s"),
                  F.sum(F.when(~clean, F.coalesce(F.col("tc"), F.lit(0))).otherwise(0)).alias("bad_t")).first()
        nb, frac = int(r["bad_b"] or 0), int(r["bad_b"] or 0) / NUM_BUCKETS
        if frac > DRILL_MAX_FRACTION:
            self.summary["compare_method"] = "FULL_DRILL"
            self.clean_cnt = 0
            self.add("DATA", "bucket_localisation", "INFO",
                     f"Whole-table fingerprint differs and {nb:,} of {NUM_BUCKETS:,} hash buckets ({frac:.1%}) "
                     f"differ - differences are spread across the table, detailed comparison run on all rows.",
                     diff=nb, note=True)
            return None
        self.clean_cnt = int(r["clean_rows"] or 0)
        self.summary["compare_method"] = "BUCKET_DRILL"
        self.add("DATA", "bucket_localisation", "INFO",
                 f"Whole-table fingerprint differs; {nb:,} of {NUM_BUCKETS:,} hash buckets ({frac:.2%}) differ. "
                 f"{self.clean_cnt:,} rows in identical buckets counted as matched; detailed comparison run on "
                 f"{int(r['bad_s'] or 0):,} source / {int(r['bad_t'] or 0):,} target rows in the differing buckets.",
                 diff=nb, note=True)
        return [int(x[0]) for x in j.where(~clean).select("b").collect()]

    # -------------------------------------------------- duplicates
    def _dups(self):
        res = {}
        hint = (" If the table keeps history (e.g. a satellite), include SYS_EFCTV_DT in the key "
                "(table:key|sys_efctv_dt).")
        for side, P, raw, names, kinds in (("source", self.src_p, self.src, self.s_names, self.s_kinds),
                                           ("target", self.tgt_p, self.tgt, self.t_names, self.t_kinds)):
            if self.keys:
                # one shuffle: partition by key hash, then count per (key, row) and roll up per key
                g = P.repartition("kh").groupBy("kh", "nh1", "nh2").agg(F.count(F.lit(1)).alias("c"))
                pk = g.groupBy("kh").agg(F.sum("c").alias("n"),
                                         F.sum(F.when(F.col("c") > 1, F.col("c") - 1).otherwise(0)).alias("ex"))
                r = pk.agg(F.sum("ex").alias("ex"),
                           F.sum(F.when(F.col("n") > 1, 1).otherwise(0)).alias("dk"),
                           F.sum(F.when(F.col("n") > 1, F.col("n")).otherwise(0)).alias("dkr")).first()
                ex, dk, dkr = int(r["ex"] or 0), int(r["dk"] or 0), int(r["dkr"] or 0)
                if dk and self.n:
                    top = {int(t["kh"]): int(t["n"]) for t in
                           pk.where("n > 1").orderBy(F.desc("n")).limit(self.n).collect()}
                    rows = (raw.select(self.raw_kh(names, kinds).alias("_h"),
                                       F.to_json(F.struct(*[C(x) for x in raw.columns])).alias("_raw"))
                               .where(F.col("_h").isin(list(top))).limit(len(top) * 3).collect())
                    for x in rows:
                        self.add_sample("DUP_KEY", side.upper(), x["_raw"],
                                        pair_id=f"key_hash={x['_h']} rows={top.get(int(x['_h']))}")
            else:
                g = P.groupBy("nh1", "nh2").agg(F.count(F.lit(1)).alias("c"))
                ex = int(g.agg(F.sum(F.when(F.col("c") > 1, F.col("c") - 1).otherwise(0))).first()[0] or 0)
                dk = dkr = None
                if ex and self.n:
                    top = {int(t["nh1"]): int(t["c"]) for t in
                           g.where("c > 1").orderBy(F.desc("c")).limit(self.n).collect()}
                    found = self.fetch(raw, names, kinds, self.raw_nh1(names, kinds), list(top))
                    for h, (rec, _) in found.items():
                        self.add_sample("DUP_ROW", side.upper(), rec, pair_id=f"row_hash={h} copies={top.get(int(h))}")
            res[side] = (ex, dk, dkr)

        (s_ex, s_dk, s_dkr), (t_ex, t_dk, t_dkr) = res["source"], res["target"]
        self.summary.update(src_duplicate_rows=s_ex, tgt_duplicate_rows=t_ex,
                            src_dup_keys=s_dk, src_dup_key_rows=s_dkr, tgt_dup_keys=t_dk, tgt_dup_key_rows=t_dkr)

        if s_ex or t_ex:
            self.add("DATA", "duplicate_records", "WARN" if s_ex == t_ex else "FAIL",
                     f"Exact full-record duplicates (extra copies): source {s_ex:,}, target {t_ex:,}"
                     + (" - same on both sides." if s_ex == t_ex else " - differs between sides.")
                     + (" Samples: DUP_ROW." if not self.keys else ""),
                     src_value=s_ex, tgt_value=t_ex, diff=abs(s_ex - t_ex))
        else:
            self.add("DATA", "duplicate_records", "PASS", "No exact duplicate records on either side.")
        if self.keys:
            keys_txt = ", ".join(self.keys)
            for side, dk, dkr, ex in (("source", s_dk, s_dkr, s_ex), ("target", t_dk, t_dkr, t_ex)):
                if dk:
                    self.add("KEY", f"duplicate_keys_{side}", DUP_KEY_STATUS,
                             f"{side.title()}: {dk:,} key value(s) on ({keys_txt}) occur more than once, covering "
                             f"{dkr:,} rows ({ex:,} of the extra rows are exact full-record copies). Top duplicates "
                             f"in recon_mismatch_samples (DUP_KEY).{hint}",
                             diff=dk, src_value=dk if side == "source" else None,
                             tgt_value=dk if side == "target" else None)
            if not s_dk and not t_dk:
                self.add("KEY", "duplicate_keys", "PASS", f"Key ({keys_txt}) is unique on both sides.")
            elif s_dk != t_dk:
                self.add("KEY", "duplicate_keys_compare", "FAIL",
                         f"Duplicate key values differ: source {s_dk:,} ({s_dkr:,} rows) vs target {t_dk:,} "
                         f"({t_dkr:,} rows).", src_value=s_dk, tgt_value=t_dk, diff=t_dk - s_dk)

    # -------------------------------------------------- samples / format detail
    def _samples(self):
        if self.nm["src_only"]:
            hs = [r["nh1"] for r in self.nm_j.where("s_cnt > t_cnt").select("nh1").limit(self.n).collect()]
            for raw, _ in self.fetch(self.src_d, self.s_names, self.s_kinds,
                                     self.raw_nh1(self.s_names, self.s_kinds), hs).values():
                self.add_sample("SRC_ONLY", "SOURCE", raw)
        if self.nm["tgt_only"]:
            hs = [r["nh1"] for r in self.nm_j.where("t_cnt > s_cnt").select("nh1").limit(self.n).collect()]
            for raw, _ in self.fetch(self.tgt_d, self.t_names, self.t_kinds,
                                     self.raw_nh1(self.t_names, self.t_kinds), hs).values():
                self.add_sample("TGT_ONLY", "TARGET", raw)

    def _format_detail_no_key(self):
        pairs = (self.sp.select("nh1", "nh2", F.col("sh1").alias("s_sh"))
                 .join(self.tp.select("nh1", "nh2", F.col("sh1").alias("t_sh")), ["nh1", "nh2"])
                 .where("s_sh <> t_sh").limit(self.n).collect())
        s_rec = self.fetch(self.src_d, self.s_names, self.s_kinds,
                           self.raw_sh1(self.s_names, self.s_kinds), {p["s_sh"] for p in pairs})
        t_rec = self.fetch(self.tgt_d, self.t_names, self.t_kinds,
                           self.raw_sh1(self.t_names, self.t_kinds), {p["t_sh"] for p in pairs})
        col_hits = {}
        for p in pairs:
            if p["s_sh"] not in s_rec or p["t_sh"] not in t_rec:
                continue
            (s_raw, s_vals), (t_raw, t_vals) = s_rec[p["s_sh"]], t_rec[p["t_sh"]]
            self.add_sample("FORMAT_DIFF", "SOURCE", s_raw, str(p["nh1"]))
            self.add_sample("FORMAT_DIFF", "TARGET", t_raw, str(p["nh1"]))
            for c in self.common:
                if s_vals.get(c) != t_vals.get(c):
                    col_hits.setdefault(c, []).append((s_vals.get(c), t_vals.get(c)))
        for c, ex in col_hits.items():
            sv, tv = ex[0]
            self.add("FORMAT", "format_mismatch_sampled", "WARN",
                     f"Format difference in '{self.s_names[c]}' ({explain_format(sv, tv)}); seen in "
                     f"{len(ex)} of {len(pairs)} sampled format-diff rows. Types: source "
                     f"{self.s_map[c].dataType.simpleString()}, target {self.t_map[c].dataType.simpleString()}. "
                     f"Give a key for exact counts.",
                     column=self.s_names[c], diff=len(ex), sample_src=sv, sample_tgt=tv)

    # -------------------------------------------------- key-level compare (differing buckets only)
    def _keyed(self):
        kc = [f"_k{i}" for i in range(len(self.keys))]
        keys_txt = ", ".join(self.keys)
        nonkey = [c for c in self.common if c not in self.keys]

        def side_df(df, names, kinds, p, flag):
            return df.select(
                *[norm_expr(names[k], kinds[k], self.canon[k]).alias(f"_k{i}") for i, k in enumerate(self.keys)],
                *[e for i, c in enumerate(nonkey) for e in
                  (strict_expr(names[c], kinds[c]).alias(f"{p}{i}"),
                   norm_expr(names[c], kinds[c], self.canon[c]).alias(f"{p}n{i}"))],
                F.lit(1).alias(flag))

        j = side_df(self.src_d, self.s_names, self.s_kinds, "s", "_in_s").join(
            side_df(self.tgt_d, self.t_names, self.t_kinds, "t", "_in_t"), kc, "full_outer")
        both = F.col("_in_s").isNotNull() & F.col("_in_t").isNotNull()
        key_json = F.to_json(F.struct(*[F.col(f"_k{i}").alias(self.s_names[k]) for i, k in enumerate(self.keys)]))

        def one(cond):
            return F.sum(F.when(cond, 1).otherwise(0))

        aggs = [one(both).alias("matched"),
                one(F.col("_in_t").isNull()).alias("src_only"),
                one(F.col("_in_s").isNull()).alias("tgt_only"),
                F.first(F.when(F.col("_in_t").isNull(), key_json), True).alias("ex_src_only"),
                F.first(F.when(F.col("_in_s").isNull(), key_json), True).alias("ex_tgt_only")]
        eqs = [F.col(f"sn{i}").eqNullSafe(F.col(f"tn{i}")) for i in range(len(nonkey))]
        aggs.append(one(both & reduce(lambda a, b: a & b, eqs, F.lit(True))).alias("all_match"))
        for i in range(len(nonkey)):
            d = both & ~eqs[i]
            f = both & eqs[i] & ~F.col(f"s{i}").eqNullSafe(F.col(f"t{i}"))

            def ex(cond, i=i):
                return F.first(F.when(cond, F.to_json(F.struct(
                    key_json.alias("key"), F.col(f"s{i}").alias("src"), F.col(f"t{i}").alias("tgt")))), True)
            aggs += [one(d).alias(f"d{i}"), one(f).alias(f"f{i}"), ex(d).alias(f"dx{i}"), ex(f).alias(f"fx{i}")]
        r = j.agg(*aggs).first()

        matched = int(r["matched"] or 0) + self.clean_cnt
        all_match = int(r["all_match"] or 0) + self.clean_cnt
        src_only, tgt_only = int(r["src_only"] or 0), int(r["tgt_only"] or 0)
        self.summary.update(key_matched=matched, key_src_only=src_only, key_tgt_only=tgt_only,
                            key_rows_all_cols_match=all_match)
        dup_note = (" (counts inflated where keys are duplicated - see duplicate_keys checks)"
                    if (self.summary.get("src_dup_keys") or self.summary.get("tgt_dup_keys")) else "")
        if src_only:
            self.add("KEY", "keys_missing_in_target", "FAIL",
                     f"{src_only:,} key(s) on ({keys_txt}) exist in source but not in target{dup_note}.",
                     diff=src_only, sample_src=r["ex_src_only"])
        if tgt_only:
            self.add("KEY", "keys_missing_in_source", "FAIL" if src_only else "WARN",
                     f"{tgt_only:,} key(s) on ({keys_txt}) exist in target but not in source"
                     + (" (all source keys found - target has extra keys)" if not src_only else "")
                     + f"{dup_note}.", diff=tgt_only, sample_tgt=r["ex_tgt_only"])
        if not src_only and not tgt_only:
            self.add("KEY", "key_coverage", "PASS", f"All {matched:,} keys present on both sides.")
        diff_rows = matched - all_match
        self.add("KEY", "matched_keys_all_columns", "PASS" if diff_rows == 0 else "FAIL",
                 f"Of {matched:,} matched keys, {all_match:,} have identical values in all {len(nonkey)} "
                 f"non-key columns (after normalisation); {diff_rows:,} differ{dup_note}.", diff=diff_rows)

        for i, c in enumerate(nonkey):
            st, tt = self.s_map[c].dataType.simpleString(), self.t_map[c].dataType.simpleString()
            if r[f"d{i}"]:
                e = json.loads(r[f"dx{i}"])
                self.add("DATA", "column_value_mismatch", "FAIL",
                         f"'{self.s_names[c]}': {r[f'd{i}']:,} matched-key rows have different values even "
                         f"after normalisation (source {st}, target {tt}). Example key {e['key']}: "
                         f"source='{e['src']}', target='{e['tgt']}'.",
                         column=self.s_names[c], diff=r[f"d{i}"], sample_src=e["src"], sample_tgt=e["tgt"])
            if r[f"f{i}"]:
                e = json.loads(r[f"fx{i}"])
                self.add("FORMAT", "column_format_mismatch", "WARN",
                         f"'{self.s_names[c]}': {r[f'f{i}']:,} matched-key rows are equal in value but differ in "
                         f"format - {explain_format(e['src'], e['tgt'])} (source {st}, target {tt}). "
                         f"Example key {e['key']}: source='{e['src']}', target='{e['tgt']}'.",
                         column=self.s_names[c], diff=r[f"f{i}"], sample_src=e["src"], sample_tgt=e["tgt"])

    # -------------------------------------------------- NULL / blank profile (differing buckets only)
    def _profile(self):
        scope = "" if self.drill is None else " (rows in differing buckets)"

        def prof(df, names, kinds):
            ex = [F.count(F.lit(1)).alias("_cnt")]
            for i, c in enumerate(self.common):
                ex.append(F.sum(F.when(C(names[c]).isNull(), 1).otherwise(0)).alias(f"n{i}"))
                ex.append(F.sum(F.when(F.trim(C(names[c]).cast("string")) == "", 1).otherwise(0)).alias(f"b{i}")
                          if kinds[c] == "str" else F.lit(0).alias(f"b{i}"))
            return df.agg(*ex).first()
        ps, pt = prof(self.src_d, self.s_names, self.s_kinds), prof(self.tgt_d, self.t_names, self.t_kinds)
        for i, c in enumerate(self.common):
            sn, tn = int(ps[f"n{i}"] or 0), int(pt[f"n{i}"] or 0)
            sb, tb = int(ps[f"b{i}"] or 0), int(pt[f"b{i}"] or 0)
            if sn != tn:
                hint = (" Likely blank-vs-NULL handling (blank counts differ in the opposite direction)."
                        if (sn - tn) * (sb - tb) < 0 else "")
                self.add("PROFILE", "null_count_mismatch", "WARN",
                         f"'{self.s_names[c]}': NULL count source {sn:,} vs target {tn:,}{scope}.{hint}",
                         column=self.s_names[c], src_value=sn, tgt_value=tn, diff=tn - sn)
            if sb != tb:
                self.add("PROFILE", "blank_count_mismatch", "WARN",
                         f"'{self.s_names[c]}': blank/whitespace-only string count source {sb:,} vs "
                         f"target {tb:,}{scope}.",
                         column=self.s_names[c], src_value=sb, tgt_value=tb, diff=tb - sb)


# ------------------------------------------------------------ ordering
def order_tables(tables, filter_col, use_filter):
    """Tables with the filter column on BOTH sides first (input order kept within each group)."""
    fc = (filter_col or "").lower()
    flagged = []
    for idx, (t, keys) in enumerate(tables):
        has = False
        if use_filter and fc:
            try:
                s = {f.name.lower() for f in spark.table(_fqn(SRC_PREFIX, t)).schema.fields}
                g = {f.name.lower() for f in spark.table(_fqn(TGT_PREFIX, t)).schema.fields}
                has = fc in s and fc in g
            except Exception:
                has = False  # unreadable tables go last; the run records the error
        flagged.append((0 if has else 1, idx, t, keys, has))
    flagged.sort(key=lambda x: (x[0], x[1]))
    return [(t, keys, has) for _, _, t, keys, has in flagged]


# ------------------------------------------------------------ main
def main(params=None):
    p = dict(PARAM_DEFAULTS, **(params or _params()))
    if not p.get("table_names") and p.get("table_name"):
        p["table_names"] = p["table_name"]
    tables = parse_tables(p["table_names"], _csv(p.get("key_columns")))
    if not tables:
        raise ValueError("TABLE_NAMES is required, e.g. silver.customer, silver.orders:order_id")
    excl = {c.lower() for c in DEFAULT_EXCLUDE_COLUMNS} | set(_csv(p.get("exclude_columns")))
    filter_col = (p.get("filter_column") or DEFAULT_FILTER_COLUMN).strip()
    win = {"mode": (p.get("filter_mode") or "FIXED").strip().upper(),
           "cutoff_from": (p.get("cutoff_from") or "SOURCE").strip().upper(),
           "hours": p.get("window_hours") or "24"}
    if win["mode"] not in ("MAX_CUTOFF", "FIXED"):
        raise ValueError("FILTER_MODE must be MAX_CUTOFF or FIXED")
    if win["cutoff_from"] not in ("SOURCE", "TARGET", "MIN"):
        raise ValueError("CUTOFF_FROM must be SOURCE, TARGET or MIN")
    float(win["hours"])  # validate
    if win["mode"] == "MAX_CUTOFF":
        f_start = f_end = None  # resolved per table from max(filter column)
    else:
        f_start, f_end = resolve_window(p.get("filter_start"), p.get("filter_end"))
    use_filter = win["mode"] == "MAX_CUTOFF" or f_start is not None or f_end is not None
    n = int(p.get("sample_rows") or 20)

    run_ts = now_local()
    run = dict(run_id=str(uuid.uuid4()), run_ts=run_ts, run_date=run_ts.date())
    ensure_output_tables()

    ordered = order_tables(tables, filter_col, use_filter)
    n_f = sum(1 for _, _, h in ordered if h)
    wtxt = (f"MAX_CUTOFF from {win['cutoff_from']}, {win['hours']}h back" if win["mode"] == "MAX_CUTOFF"
            else f"{f_start} -> {f_end}")
    print(f"run_id={run['run_id']}  window={wtxt}  tables={len(ordered)} "
          f"({n_f} with {filter_col.upper()} first, {len(ordered) - n_f} without)  parallel={PARALLEL_TABLES}")

    def one(seq, table, keys, has):
        t0 = time.time()
        try:
            status = Recon(table, list(keys), excl, filter_col, f_start, f_end, n, run, win, seq).run()
        except Exception as e:  # e.g. output write failed - keep going with the next table
            status = f"ERROR (not recorded: {type(e).__name__}: {str(e)[:300]})"
        with _PRINT_LOCK:
            print(f"  {seq:>3}. {'[F]' if has else '[ ]'} {table:<60} {status}  ({time.time() - t0:.0f}s)")
        return table, status

    results = {}
    with ThreadPoolExecutor(max_workers=max(1, int(PARALLEL_TABLES))) as pool:
        futures = [pool.submit(one, i + 1, t, k, h) for i, (t, k, h) in enumerate(ordered)]
        for f in futures:
            t, s = f.result()
            results[t] = s

    try:
        display(spark.table(f"{OUT_SCHEMA}.recon_summary")  # noqa: F821
                .where(F.col("run_id") == run["run_id"]).orderBy("run_seq")
                .select("run_seq", "table_name", "overall_status", "compare_method", "filter_applied",
                        "src_count", "tgt_count", "src_duplicate_rows", "tgt_duplicate_rows",
                        "src_dup_keys", "tgt_dup_keys", "comments"))
    except NameError:
        pass
    return run["run_id"], results


if __name__ == "__main__":
    main()
