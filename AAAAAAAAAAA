# MAIN
# ---------------------------------------------------------------------------
RUN_ID = time.strftime("%Y%m%d_%H%M%S", time.gmtime())


def apply_spark_conf():
    confs = {
        "spark.sql.adaptive.enabled": "true",
        "spark.sql.adaptive.skewJoin.enabled": "true",
        "spark.sql.adaptive.coalescePartitions.enabled": "true",
        "spark.databricks.delta.optimizeWrite.enabled": "true",
        "spark.databricks.delta.autoCompact.enabled": "true",
    }
    if SESSION_TIMEZONE:
        confs["spark.sql.session.timeZone"] = SESSION_TIMEZONE
    for k, v in confs.items():
        try:
            spark.conf.set(k, v)
        except Exception:
            pass  # some compute types lock these - safe to ignore


def ensure_tables():
    spark.sql(f"CREATE TABLE IF NOT EXISTS {SUMMARY_OUTPUT_TABLE} ({SUMMARY_ROW_DDL}, {RUN_COLS_DDL}) "
              f"USING DELTA PARTITIONED BY (run_date)")
    spark.sql(f"CREATE TABLE IF NOT EXISTS {DETAIL_OUTPUT_TABLE} ({DETAIL_ROW_DDL}, {RUN_COLS_DDL}) "
              f"USING DELTA PARTITIONED BY (run_date)")
    spark.sql(f"CREATE TABLE IF NOT EXISTS {WATERMARK_TABLE} (source_system STRING, table_name STRING, "
              f"last_reconciled_id LONG, updated_at TIMESTAMP) USING DELTA")


def main():
    from delta.tables import DeltaTable

    apply_spark_conf()
    w = spark.sql(
        f"SELECT date_format(CAST(concat(date_sub(current_date(), {LOOKBACK_DAYS}), ' {BATCH_CUTOFF_HOUR:02d}:00:00') AS TIMESTAMP), 'yyyy-MM-dd HH:mm:ss') AS ws, "
        f"date_format(CAST(concat(current_date(), ' {BATCH_CUTOFF_HOUR:02d}:00:00') AS TIMESTAMP), 'yyyy-MM-dd HH:mm:ss') AS we"
    ).first()
    ws, we = w["ws"], w["we"]
    print(f"Window: {ws} -> {we}")

    ensure_tables()

    src_tables, tgt_tables = list_tables(CATALOG_SRC), list_tables(CATALOG_TGT)
    if TEST_TABLES:
        wanted = {t.lower() for t in TEST_TABLES}
        src_tables = {k: v for k, v in src_tables.items() if v.lower() in wanted}
        tgt_tables = {k: v for k, v in tgt_tables.items() if v.lower() in wanted}
        found = {v.lower() for v in list(src_tables.values()) + list(tgt_tables.values())}
        print(f"TEST MODE: {len(wanted)} table(s) requested, outputs go to *{TEST_OUTPUT_SUFFIX} tables")
        for t in sorted(wanted - found):
            print(f"  [WARN] {t} not found in either catalog (check the name, and that it doesn't end _sa/_cda)")
    both = sorted(set(src_tables) & set(tgt_tables))
    only_s = sorted(set(src_tables) - set(tgt_tables))
    only_t = sorted(set(tgt_tables) - set(src_tables))
    print(f"Tables: {len(both)} in both, {len(only_s)} only in {LABEL_SRC}, {len(only_t)} only in {LABEL_TGT}")

    cols_s = list_columns(CATALOG_SRC, {src_tables[k] for k in both})
    cols_t = list_columns(CATALOG_TGT, {tgt_tables[k] for k in both})
    plans = {k: build_plan(k, src_tables[k], tgt_tables[k],
                           cols_s.get(src_tables[k], []), cols_t.get(tgt_tables[k], []))
             for k in both}

    wms = {}
    for r in spark.sql(f"SELECT source_system, table_name, last_reconciled_id FROM {WATERMARK_TABLE}").collect():
        wms[(r["source_system"], r["table_name"])] = r["last_reconciled_id"]

    rows, new_wms = [], {}
    with ThreadPoolExecutor(max_workers=MAX_PARALLEL_TABLES) as ex:
        futs = {ex.submit(reconcile_table, k, plans[k], wms.get(k, -1), ws, we): k for k in both}
        done = 0
        for f in as_completed(futs):
            row, nwm = f.result()
            rows.append(row)
            if nwm is not None:
                new_wms[futs[f]] = nwm
            done += 1
            if done % 25 == 0 or done == len(futs):
                print(f"  {done}/{len(futs)} tables done")

    for k in only_s:
        r = blank_row(*k)
        r.update(strategy="TABLE_MISSING", count_status=count_status(None, None, miss_t=True),
                 issue_summary="TABLE_MISSING", comments=f"Table not present in {LABEL_TGT}")
        rows.append(r)
    for k in only_t:
        r = blank_row(*k)
        r.update(strategy="TABLE_MISSING", count_status=count_status(None, None, miss_s=True),
                 issue_summary="TABLE_MISSING", comments=f"Table not present in {LABEL_SRC}")
        rows.append(r)

    summary = (spark.createDataFrame([tuple(r[n] for n, _ in SUMMARY_FIELDS) for r in rows], SUMMARY_ROW_DDL)
               .withColumn("run_id", F.lit(RUN_ID)).withColumn("run_timestamp", F.current_timestamp())
               .withColumn("run_date", F.current_date()).withColumn("is_latest_for_day", F.lit("Y")))
    summary.write.format("delta").mode("append").option("mergeSchema", "true").saveAsTable(SUMMARY_OUTPUT_TABLE)

    for t in (SUMMARY_OUTPUT_TABLE, DETAIL_OUTPUT_TABLE):
        dt = DeltaTable.forName(spark, t)
        dt.update(condition=f"run_date = current_date() AND run_id <> '{RUN_ID}'", set={"is_latest_for_day": "'N'"})
        dt.delete(f"run_date < date_sub(current_date(), {RETENTION_DAYS})")

    if new_wms:
        wm_df = spark.createDataFrame(
            [(k[0], k[1], int(v)) for k, v in new_wms.items()],
            "source_system STRING, table_name STRING, last_reconciled_id LONG"
        ).withColumn("updated_at", F.current_timestamp())
        (DeltaTable.forName(spark, WATERMARK_TABLE).alias("t")
         .merge(wm_df.alias("s"), "t.source_system = s.source_system AND t.table_name = s.table_name")
         .whenMatchedUpdate(condition="s.last_reconciled_id > t.last_reconciled_id",
                            set={"last_reconciled_id": "s.last_reconciled_id", "updated_at": "s.updated_at"})
         .whenNotMatchedInsertAll().execute())
        print(f"Advanced watermarks for {len(new_wms)} table(s).")

    print("Breakdown by issue_summary:")
    summary.groupBy("issue_summary").count().orderBy(F.desc("count")).show(30, truncate=False)
    print("Breakdown by count_status (type only):")
    (summary.withColumn("status_type", F.regexp_extract("count_status", r"^(COUNT MATCH|COUNT MISMATCH|NO DATA|TABLE MISSING)", 1))
     .groupBy("status_type").count().orderBy(F.desc("count")).show(10, truncate=False))
    print(f"Wrote {SUMMARY_OUTPUT_TABLE} and {DETAIL_OUTPUT_TABLE} (run_id={RUN_ID})")


if os.environ.get("RECON_SKIP_MAIN") != "1":
    main()
