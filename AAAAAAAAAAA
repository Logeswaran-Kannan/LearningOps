def parse_table(name):
    low = name.lower()
    if low.endswith(SKIP_SUFFIXES):
        return None
    for system, prefix in SOURCE_SYSTEM_PREFIX.items():
        if low.startswith(prefix):
            base = low[len(prefix):]
            if base and base not in {t.lower() for t in EXCLUDED_TABLES}:
                return system, base
    return None


def list_tables(catalog):
    rows = spark.sql(
        f"SELECT table_name FROM {catalog}.information_schema.tables WHERE table_schema = '{SCHEMA}'"
    ).collect()
    out = {}
    for r in rows:
        k = parse_table(r["table_name"])
        if k:
            out[k] = r["table_name"]
    return out


def list_columns(catalog, wanted_physical):
    rows = spark.sql(
        f"SELECT table_name, column_name, data_type FROM {catalog}.information_schema.columns "
        f"WHERE table_schema = '{SCHEMA}'"
    ).collect()
    out = {}
    for r in rows:
        if r["table_name"] in wanted_physical:
            out.setdefault(r["table_name"], []).append((r["column_name"], base_type(r["data_type"])))
    return out


def build_plan(key, phys_s, phys_t, cols_s, cols_t):
    sm = {n.lower(): (n, bt) for n, bt in cols_s}
    tm = {n.lower(): (n, bt) for n, bt in cols_t}
    plan = {"system": key[0], "base": key[1], "phys_s": phys_s, "phys_t": phys_t}

    plan["has_id"] = ID_COLUMN in sm and ID_COLUMN in tm
    if plan["has_id"]:
        plan["id_s"], plan["id_bt_s"] = sm[ID_COLUMN]
        plan["id_t"], plan["id_bt_t"] = tm[ID_COLUMN]
        plan["key_s"], plan["key_t"], plan["key_kind"] = key_exprs(
            plan["id_s"], plan["id_bt_s"], plan["id_t"], plan["id_bt_t"])

    plan["window_col_s"] = plan["window_col_t"] = None
    for cand in WINDOW_COLUMN_CANDIDATES:
        if cand in sm and cand in tm:
            plan["window_col_s"], plan["window_bt_s"] = sm[cand]
            plan["window_col_t"], plan["window_bt_t"] = tm[cand]
            break

    common = (set(sm) & set(tm)) - _EXCLUDED_LOWER - {ID_COLUMN}
    cols = []
    for low in sorted(common):
        ns, bs = sm[low]
        nt, bt_ = tm[low]
        cat = pair_category(type_class(bs), type_class(bt_))
        cols.append({
            "name_s": ns, "name_t": nt, "bt_s": bs, "bt_t": bt_, "category": cat,
            "norm_s": norm_expr(ns, bs, cat), "norm_t": norm_expr(nt, bt_, cat),
        })
    plan["cols"] = cols
    plan["only_s"] = sorted(sm[k][0] for k in set(sm) - set(tm) - _EXCLUDED_LOWER)
    plan["only_t"] = sorted(tm[k][0] for k in set(tm) - set(sm) - _EXCLUDED_LOWER)
    plan["cross_type"] = [c for c in cols if c["bt_s"] != c["bt_t"]]
    return plan


# ---------------------------------------------------------------------------
# CORE COMPARISON
# ---------------------------------------------------------------------------
def scope_conditions(plan, side, wm, ws, we):
    conds = []
    if plan["has_id"]:
        conds.append(f"{plan['key_' + side]} IS NOT NULL")
    strategy = plan["strategy"]
    if strategy == "DATE_FILTERED":
        col, bt = plan["window_col_" + side], plan["window_bt_" + side]
        e = q(col) if type_class(bt) == "TEMPORAL" else f"try_cast({q(col)} AS TIMESTAMP)"
        conds.append(f"{e} >= TIMESTAMP'{ws}' AND {e} < TIMESTAMP'{we}'")
    elif strategy == "ID_WATERMARK":
        conds.append(f"CAST({q(plan['id_' + side])} AS BIGINT) > {wm}")
    return conds


def where_sql(conds):
    return ("WHERE " + " AND ".join(conds)) if conds else ""


def scoped_count(catalog, phys, conds):
    return spark.sql(f"SELECT COUNT(*) FROM {catalog}.{SCHEMA}.{phys} {where_sql(conds)}").first()[0]


def raw_hash_sql(cols, side):
    """Hash of the RAW text of every compared column (no normalization)."""
    parts = ", ".join(f"COALESCE(CAST({q(c['name_' + side])} AS STRING), '{NULL_TOKEN}')" for c in cols)
    return f"xxhash64(CONCAT_WS('{SEP}', {parts}))" if parts else "xxhash64('')"


def _agg_side(sql, p, with_raw):
    aggs = [F.count(F.lit(1)).alias(f"{p}_n"),
            F.min("row_hash").alias(f"{p}_hmin"),
            F.max("row_hash").alias(f"{p}_hmax")]
    if with_raw:
        aggs += [F.min("row_raw_hash").alias(f"{p}_rmin"), F.max("row_raw_hash").alias(f"{p}_rmax")]
    return spark.sql(sql).groupBy("row_key").agg(*aggs)


def build_joined(src_sql, tgt_sql, with_raw=False):
    s, t = _agg_side(src_sql, "s", with_raw), _agg_side(tgt_sql, "t", with_raw)
    same = ((F.col("s_n") == F.col("t_n")) & (F.col("s_hmin") == F.col("t_hmin"))
            & (F.col("s_hmax") == F.col("t_hmax")))
    single = (F.col("s_n") == 1) & (F.col("t_n") == 1)
    status = (F.when(F.col("s_n").isNull(), "MISSING_IN_CORE")
              .when(F.col("t_n").isNull(), "MISSING_IN_CORE_TST_STD001")
              .when(same, "MATCH")
              .when(single, "MISMATCH")
              .otherwise("DUPLICATE_ID"))
    j = s.join(t, "row_key", "full_outer").withColumn("status", status)
    if with_raw:
        raw_diff = F.coalesce((F.col("s_rmin") != F.col("t_rmin")) | (F.col("s_rmax") != F.col("t_rmax")),
                              F.lit(False))
        # FORMAT-only: normalized values agree (MATCH) but raw text differs
        j = j.withColumn("fmt_diff", (F.col("status") == "MATCH") & raw_diff)
    else:
        j = j.withColumn("fmt_diff", F.lit(False))
    return j


def summarize_joined(joined, bigint_key):
    nz = lambda c: F.coalesce(F.sum(c), F.lit(0))
    cnt = lambda st: F.sum(F.when(F.col("status") == st, 1).otherwise(0))
    aggs = [
        nz("s_n").alias("count_s"), nz("t_n").alias("count_t"),
        F.coalesce(F.sum(F.when(F.col("fmt_diff"), 1).otherwise(0)), F.lit(0)).alias("fmt"),
        F.coalesce(cnt("MATCH"), F.lit(0)).alias("match"),
        F.coalesce(cnt("MISMATCH"), F.lit(0)).alias("mismatch"),
        F.coalesce(cnt("MISSING_IN_CORE"), F.lit(0)).alias("miss_s"),
        F.coalesce(cnt("MISSING_IN_CORE_TST_STD001"), F.lit(0)).alias("miss_t"),
        F.coalesce(cnt("DUPLICATE_ID"), F.lit(0)).alias("dup"),
    ]
    if bigint_key:
        aggs += [F.max("row_key").alias("max_key"),
                 F.min(F.when(F.col("status") != "MATCH", F.col("row_key"))).alias("min_unresolved")]
    return joined.agg(*aggs).first().asDict()


def _in_list(ids, kind):
    if kind == "BIGINT":
        return ", ".join(str(int(i)) for i in ids)
    return ", ".join(f"'{esc(str(i))}'" for i in ids)


def column_diff(plan, ids):
    """Column-level diff for a bounded set of ids. Returns a DataFrame."""
    cols = plan["cols"]
    if not cols or not ids:
        return None
    in_list = _in_list(ids, plan["key_kind"])

    def side_sql(catalog, phys, key_expr, side):
        pairs = ", ".join(
            f"'{esc(c['name_s'])}', {c['norm_' + side]}, "
            f"SUBSTRING(CAST({q(c['name_' + side])} AS STRING), 1, {MAX_VALUE_LEN})"
            for c in cols)
        return (f"SELECT {key_expr} AS row_key, stack({len(cols)}, {pairs}) "
                f"AS (column_name, norm_value, raw_value) "
                f"FROM {catalog}.{SCHEMA}.{phys} WHERE {key_expr} IN ({in_list})")

    s = spark.sql(side_sql(CATALOG_SRC, plan["phys_s"], plan["key_s"], "s")) \
        .withColumnRenamed("norm_value", "s_norm").withColumnRenamed("raw_value", "s_raw")
    t = spark.sql(side_sql(CATALOG_TGT, plan["phys_t"], plan["key_t"], "t")) \
        .withColumnRenamed("norm_value", "t_norm").withColumnRenamed("raw_value", "t_raw")

    def cmap(fn):
        return F.create_map(*[x for c in cols for x in (F.lit(c["name_s"]), F.lit(fn(c)))])

    cat_map = cmap(lambda c: c["category"])
    ty_s = cmap(lambda c: c["bt_s"])
    ty_t = cmap(lambda c: c["bt_t"])

    norm_differs = ~F.col("s_norm").eqNullSafe(F.col("t_norm"))
    raw_differs = ~F.col("s_raw").eqNullSafe(F.col("t_raw"))
    return (s.join(t, ["row_key", "column_name"], "inner")
            .filter(norm_differs | raw_differs)
            .select(
                F.lit(plan["system"]).alias("source_system"),
                F.lit(plan["base"]).alias("table_name"),
                # display only: 9408581.000000000 -> 9408581 (decimal-keyed ids)
                F.when(F.col("row_key").cast("string").contains("."),
                       F.regexp_replace(F.regexp_replace(F.col("row_key").cast("string"), "0+$", ""),
                                        "\\.$", ""))
                 .otherwise(F.col("row_key").cast("string")).alias("id"),
                "column_name",
                cat_map[F.col("column_name")].alias("compare_category"),
                ty_s[F.col("column_name")].alias("core_data_type"),
                ty_t[F.col("column_name")].alias("core_tst_std001_data_type"),
                F.col("s_raw").alias("core_value"),
                F.col("t_raw").alias("core_tst_std001_value"),
                F.when(norm_differs, "VALUE").otherwise("FORMAT").alias("diff_kind"),
                F.when(~norm_differs, "FORMAT_ONLY")
                 .when(F.col("s_norm").isNull(), "NULL_IN_CORE")
                 .when(F.col("t_norm").isNull(), "NULL_IN_CORE_TST_STD001")
                 .otherwise("VALUE_MISMATCH").alias("mismatch_type")))


def _short(v):
    v = "NULL" if v is None else str(v)
    return v if len(v) <= COMMENT_VALUE_MAX_LEN else v[:COMMENT_VALUE_MAX_LEN] + "..."


def build_column_comment(stats, examples, total_diff_rows, sampled_ids):
    """stats: {column: (value_rows, format_rows)}
       examples: {column: [(id, core_value, cda_value, kind), ...]}
       -> 'COLUMN MISMATCHES -> COL: n row(s) differ [x VALUE, y FORMAT] (e.g. id=..: CORE='..' vs CDA='..' [FORMAT]; ..); ...'"""
    if not stats:
        return ""
    ordered = sorted(stats.items(), key=lambda kv: (-kv[1][0], -kv[1][1], kv[0].lower()))
    parts = []
    for col, (v, f) in ordered[:COMMENT_MAX_COLUMNS]:
        ex = "; ".join(
            f"id={i}: CORE='{_short(a)}' vs CDA='{_short(b)}' [{k}]"
            for i, a, b, k in examples.get(col, [])[:COMMENT_EXAMPLES_PER_COLUMN])
        parts.append(f"{col.upper()}: {v + f} row(s) differ [{v} VALUE, {f} FORMAT]" + (f" (e.g. {ex})" if ex else ""))
    if len(ordered) > COMMENT_MAX_COLUMNS:
        parts.append(f"...and {len(ordered) - COMMENT_MAX_COLUMNS} more column(s)")
    head = "COLUMN MISMATCHES"
    if sampled_ids < total_diff_rows:
        head += f" (counts from a sample of {sampled_ids} of {total_diff_rows} differing row(s))"
    return head + " -> " + "; ".join(parts)


def write_detail(df):
    (df.withColumn("run_id", F.lit(RUN_ID)).withColumn("run_timestamp", F.current_timestamp())
       .withColumn("run_date", F.current_date()).withColumn("is_latest_for_day", F.lit("Y"))
       .write.format("delta").mode("append").option("mergeSchema", "true")
       .saveAsTable(DETAIL_OUTPUT_TABLE))


def count_status(n_s, n_t, miss_s=None, miss_t=None):
    if miss_s and miss_t:
        return "TABLE MISSING in both"
    if miss_s:
        return f"TABLE MISSING in {LABEL_SRC}"
    if miss_t:
        return f"TABLE MISSING in {LABEL_TGT}"
    if (n_s or 0) == 0 and (n_t or 0) == 0:
        return "NO DATA"
    if n_s == n_t:
        return "COUNT MATCH"
    hi = LABEL_SRC if n_s > n_t else LABEL_TGT
    return f"COUNT MISMATCH - {hi} HIGHER by {abs(n_s - n_t)}"


def blank_row(system, base):
    r = {n: None for n, _ in SUMMARY_FIELDS}
    r["source_system"], r["table_name"] = system, base
    return r


def classify_missing(plan, joined, status, side):
    """Rows missing from `side` inside the scope: are they truly absent there, or
    present but outside the date window / id watermark? Returns
    (outside_count, truly_missing_count, sample[(key, present_bool)])."""
    catalog = CATALOG_SRC if side == "s" else CATALOG_TGT
    phys, key = plan["phys_" + side], plan["key_" + side]
    keys = joined.filter(F.col("status") == status).select("row_key")
    full = (spark.sql(f"SELECT DISTINCT {key} AS row_key FROM {catalog}.{SCHEMA}.{phys} "
                      f"WHERE {key} IS NOT NULL")
            .withColumn("present", F.lit(True)))
    m = keys.join(full, "row_key", "left").cache()
    try:
        agg = m.agg(F.count(F.lit(1)).alias("n"),
                    F.sum(F.when(F.col("present"), 1).otherwise(0)).alias("p")).first()
        total, outside = int(agg["n"] or 0), int(agg["p"] or 0)
        sample = [(r["row_key"], bool(r["present"]))
                  for r in m.limit(DETAIL_MAX_MISSING_IDS_PER_TABLE).collect()]
    finally:
        m.unpersist()
    return outside, total - outside, sample


def reconcile_table(key, plan, wm, ws, we):
    t0 = time.time()
    row = blank_row(*key)
    new_wm = None
    try:
        # ---- strategy ----
        if not plan["has_id"]:
            plan["strategy"] = "NO_KEY_SKIP"
        elif plan["window_col_s"]:
            plan["strategy"] = "DATE_FILTERED"
        else:
            n = spark.sql(f"SELECT COUNT(*) FROM {CATALOG_SRC}.{SCHEMA}.{plan['phys_s']}").first()[0]
            if n < SMALL_TABLE_ROW_THRESHOLD:
                plan["strategy"] = "FULL_HASH"
            elif plan["id_bt_s"] in INTEGRAL_TYPES and plan["id_bt_t"] in INTEGRAL_TYPES:
                plan["strategy"] = "ID_WATERMARK"
            else:
                plan["strategy"] = "FULL_HASH"
                row["comments"] = "id is not integral so no watermark possible - full table compared. "
        row["strategy"] = plan["strategy"]
        if plan["strategy"] == "DATE_FILTERED" or (plan["strategy"] == "NO_KEY_SKIP" and plan["window_col_s"]):
            row["window_start"], row["window_end"] = ws, we

        notes = []
        row["columns_compared"] = len(plan["cols"])
        row["columns_normalized_cross_type"] = len(plan["cross_type"])
        row["only_in_core"] = ",".join(plan["only_s"][:30]) or None
        row["only_in_core_tst_std001"] = ",".join(plan["only_t"][:30]) or None

        # NO_KEY_SKIP tables: windowed counts only
        if plan["strategy"] == "NO_KEY_SKIP":
            tmp = dict(plan, strategy="DATE_FILTERED" if plan["window_col_s"] else "FULL_HASH")
            ns = scoped_count(CATALOG_SRC, plan["phys_s"], scope_conditions(tmp, "s", wm, ws, we))
            nt = scoped_count(CATALOG_TGT, plan["phys_t"], scope_conditions(tmp, "t", wm, ws, we))
            row.update(count_core=ns, count_core_tst_std001=nt, count_diff=ns - nt,
                       count_status=count_status(ns, nt), issue_summary="NO_KEY_SKIP",
                       comments="No 'id' column on both sides - row-level comparison skipped, counts only")
            return row, None

        # ---- hash both sides, one narrow projection each ----
        hs = row_hash_sql([c["norm_s"] for c in plan["cols"]])
        ht = row_hash_sql([c["norm_t"] for c in plan["cols"]])
        rs = f", {raw_hash_sql(plan['cols'], 's')} AS row_raw_hash" if DETECT_FORMAT_DIFFS else ""
        rt = f", {raw_hash_sql(plan['cols'], 't')} AS row_raw_hash" if DETECT_FORMAT_DIFFS else ""
        src_sql = (f"SELECT {plan['key_s']} AS row_key, {hs} AS row_hash{rs} "
                   f"FROM {CATALOG_SRC}.{SCHEMA}.{plan['phys_s']} "
                   f"{where_sql(scope_conditions(plan, 's', wm, ws, we))}")
        tgt_sql = (f"SELECT {plan['key_t']} AS row_key, {ht} AS row_hash{rt} "
                   f"FROM {CATALOG_TGT}.{SCHEMA}.{plan['phys_t']} "
                   f"{where_sql(scope_conditions(plan, 't', wm, ws, we))}")
        joined = build_joined(src_sql, tgt_sql, with_raw=DETECT_FORMAT_DIFFS)
        bigint = plan["key_kind"] == "BIGINT"
        a = summarize_joined(joined, bigint)

        row.update(
            count_core=a["count_s"], count_core_tst_std001=a["count_t"],
            count_diff=a["count_s"] - a["count_t"],
            count_status=count_status(a["count_s"], a["count_t"]),
            rows_compared=a["match"] + a["mismatch"] + a["dup"],
            match_count=a["match"], mismatch_count=a["mismatch"],
            missing_in_core_count=a["miss_s"], missing_in_core_tst_std001_count=a["miss_t"],
            duplicate_id_count=a["dup"], format_diff_row_count=a["fmt"])
        denom = a["match"] + a["mismatch"] + a["dup"]
        row["match_pct"] = round(100.0 * a["match"] / denom, 2) if denom else None

        # ---- drill-down only where needed (VALUE mismatches and FORMAT-only rows) ----
        stats, examples, sampled_ids = {}, {}, 0
        if a["mismatch"] > 0 or a["fmt"] > 0:
            ids = []
            if a["mismatch"] > 0:
                ids += [r["row_key"] for r in joined.filter(F.col("status") == "MISMATCH")
                        .select("row_key").limit(DETAIL_MAX_IDS_PER_TABLE).collect()]
            if a["fmt"] > 0:
                ids += [r["row_key"] for r in joined.filter(F.col("fmt_diff"))
                        .select("row_key").limit(DETAIL_MAX_FORMAT_IDS_PER_TABLE).collect()]
            ids = list(dict.fromkeys(ids))
            sampled_ids = len(ids)
            diff = column_diff(plan, ids)
            if diff is not None:
                diff = diff.cache()
                diff.count()
                for r in (diff.groupBy("column_name").agg(
                        F.sum(F.when(F.col("diff_kind") == "VALUE", 1).otherwise(0)).alias("v"),
                        F.sum(F.when(F.col("diff_kind") == "FORMAT", 1).otherwise(0)).alias("f")).collect()):
                    stats[r["column_name"]] = (int(r["v"]), int(r["f"]))
                w_ex = Window.partitionBy("column_name").orderBy(F.col("diff_kind").desc(), F.col("id"))
                for r in (diff.withColumn("rn", F.row_number().over(w_ex))
                          .filter(F.col("rn") <= COMMENT_EXAMPLES_PER_COLUMN)
                          .select("column_name", "id", "core_value", "core_tst_std001_value", "diff_kind").collect()):
                    examples.setdefault(r["column_name"], []).append(
                        (r["id"], r["core_value"], r["core_tst_std001_value"], r["diff_kind"]))
                for lst in examples.values():
                    lst.sort(key=lambda x: (x[3] != "VALUE", str(x[0])))
                write_detail(diff)
                diff.unpersist()
        # missing rows: truly absent vs present-but-outside-window (timing skew)
        scoped = plan["strategy"] in ("DATE_FILTERED", "ID_WATERMARK")
        out = {"s": 0, "t": 0}
        true_miss = {"s": a["miss_s"], "t": a["miss_t"]}
        miss_rows = []
        for side, st, lbl in (("s", "MISSING_IN_CORE", "CORE"), ("t", "MISSING_IN_CORE_TST_STD001", "CORE_TST_STD001")):
            if true_miss[side] <= 0:
                continue
            if scoped:
                out[side], true_miss[side], sample = classify_missing(plan, joined, st, side)
            else:
                sample = [(r["row_key"], False) for r in joined.filter(F.col("status") == st)
                          .select("row_key").limit(DETAIL_MAX_MISSING_IDS_PER_TABLE).collect()]
            for k, present in sample:
                miss_rows.append((plan["system"], plan["base"], str(k), "<ROW>", "ROW", None, None, None, None,
                                  "OUTSIDE_WINDOW" if present else "MISSING_ROW",
                                  ("ROW_OUTSIDE_WINDOW_IN_" if present else "ROW_MISSING_IN_") + lbl))
        if miss_rows:
            write_detail(spark.createDataFrame(miss_rows, DETAIL_ROW_DDL))
        row["missing_in_core_count"], row["missing_in_core_tst_std001_count"] = true_miss["s"], true_miss["t"]
        row["outside_window_in_core_count"], row["outside_window_in_core_tst_std001_count"] = out["s"], out["t"]

        # ---- watermark ----
        if plan["strategy"] == "ID_WATERMARK" and bigint and a.get("max_key") is not None:
            cand = a["max_key"]
            if WATERMARK_HOLD_ON_UNRESOLVED and a.get("min_unresolved") is not None:
                cand = a["min_unresolved"] - 1
            new_wm = max(cand, wm)
            notes.append(f"ID watermark: compared ids > {wm}, new watermark {new_wm}")

        # ---- summary text ----
        flags = []
        if a["mismatch"]:
            flags.append("DATA_MISMATCH")
        if true_miss["s"] or true_miss["t"]:
            flags.append("MISSING_ROWS")
        if out["s"] or out["t"]:
            flags.append("WINDOW_SKEW")  # informational - row exists, just outside the window
        if a["dup"]:
            flags.append("DUPLICATE_IDS")
        if plan["only_s"] or plan["only_t"]:
            flags.append("COLUMN_SET_MISMATCH")
        if a["fmt"]:
            flags.append("FORMAT_DIFF")  # informational - not a failure
        if len(flags) == 1 and flags[0] in ("FORMAT_DIFF", "WINDOW_SKEW"):
            flags = [flags[0] + "_ONLY"]
        row["issue_summary"] = "+".join(flags) if flags else (
            "NO_DATA" if a["count_s"] == 0 and a["count_t"] == 0 else "OK")

        sentences = []
        if row["comments"]:
            sentences.append(row["comments"].strip())
        sentences.append(f"Full key-based compare on ID: {row['rows_compared']} matched row(s) checked.")
        col_comment = build_column_comment(stats, examples, a["mismatch"] + a["fmt"], sampled_ids)
        if col_comment:
            sentences.append(col_comment + ".")
        value_cols = [c for c, (v, f) in sorted(stats.items(), key=lambda kv: (-kv[1][0], kv[0].lower())) if v > 0]
        format_cols = [c for c, (v, f) in sorted(stats.items(), key=lambda kv: (-kv[1][1], kv[0].lower())) if f > 0]
        row["value_mismatch_columns"] = ",".join(value_cols[:25]) or None
        row["format_diff_columns"] = ",".join(format_cols[:25]) or None
        if true_miss["s"]:
            notes.append(f"{true_miss['s']} row(s) truly missing in {LABEL_SRC}")
        if true_miss["t"]:
            notes.append(f"{true_miss['t']} row(s) truly missing in {LABEL_TGT}")
        if out["s"]:
            notes.append(f"{out['s']} row(s) in the window on {LABEL_TGT} exist in {LABEL_SRC} but outside the window "
                         f"(timestamp/sync skew, not missing data)")
        if out["t"]:
            notes.append(f"{out['t']} row(s) in the window on {LABEL_SRC} exist in {LABEL_TGT} but outside the window "
                         f"(timestamp/sync skew, not missing data)")
        if a["dup"]:
            notes.append(f"{a['dup']} id(s) duplicated on one/both sides")
        if plan["only_s"]:
            notes.append(f"Columns only in {LABEL_SRC}: {','.join(plan['only_s'][:15])}")
        if plan["only_t"]:
            notes.append(f"Columns only in {LABEL_TGT}: {','.join(plan['only_t'][:15])}")
        if plan["cross_type"]:
            ex = ", ".join(f"{c['name_s']}({c['bt_s']}/{c['bt_t']})" for c in plan["cross_type"][:5])
            notes.append(f"{len(plan['cross_type'])} column(s) normalized across differing datatypes e.g. {ex}")
        sentences += [n.rstrip(".") + "." for n in notes]
        if plan["strategy"] == "DATE_FILTERED":
            sentences.append(f"Incremental filter on {plan['window_col_s'].upper()} window ('{ws}', '{we}').")
        row["comments"] = " ".join(sentences)[:COMMENT_MAX_CHARS]
    except Exception as e:  # one bad table must not stop the run
        row["issue_summary"] = "ERROR"
        row["comments"] = f"{type(e).__name__}: {str(e)[:900]}"
        new_wm = None
    row["elapsed_seconds"] = round(time.time() - t0, 1)
    return row, new_wm


