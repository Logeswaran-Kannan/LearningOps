WITH base AS (
    SELECT
        headers['MQSQuoteId'] AS mqs_quote_id,
        headers['messageType'] AS message_type,
        headers['quoteStep'] AS quote_step,
        TO_DATE(headers['quoteDate']) AS quote_date,
        enqueuedTime,
        DATE(enqueuedTime) AS enqueue_date
    FROM core.mqs_athn_mtr.ehubstream
    WHERE headers['MQSQuoteId'] IS NOT NULL
)

SELECT
    mqs_quote_id,
    message_type,

    COUNT(*) AS occurrence_count,
    COUNT(DISTINCT quote_step) AS distinct_quote_steps,
    COUNT(DISTINCT enqueue_date) AS distinct_enqueue_dates,

    MIN(enqueuedTime) AS first_arrival,
    MAX(enqueuedTime) AS last_arrival,

    COLLECT_SET(quote_step) AS quote_steps,
    COLLECT_SET(CAST(enqueue_date AS STRING)) AS enqueue_dates,
    COLLECT_SET(CAST(quote_date AS STRING)) AS quote_dates

FROM base
GROUP BY
    mqs_quote_id,
    message_type

HAVING COUNT(*) > 1
ORDER BY occurrence_count DESC;


