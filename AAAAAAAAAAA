# =============================================================================
# Duplicate Check Framework  -  driven by control table `radarlivetableinput`
# =============================================================================
# WHAT THIS DOES
# ---------------------------------------------------------------------------
# 1. Reads radarlivetableinput, keeps only rows where include = 'Y'.
# 2. Optionally filters to specific Layer(s) for the run (LAYER_FILTER below,
#    or pass a list into run_all()).
# 3. For each table:
#       - Resolves full table name from catalog_prd.Schema.Tablename_Prod
#       - Filters rows using filter_timestamp column + startdt/enddt
#         (falls back to a FULL table scan if no start/end is available)
#       - landing / bronze / pricingviews layers -> exact duplicate check on
#         `Payload`,
#         keyed by headers['messageType'] + headers['MQSQuoteId']
#       - all other layers -> generic duplicate check on every column
#         EXCEPT the ones listed in exclude_column
# 4. Prints + persists a detailed summary: period checked, total count,
#    duplicate group count, duplicate row count, duplicate %, runtime, etc.
#
# PERFORMANCE NOTES
# ---------------------------------------------------------------------------
# - Projects (select) down to only the columns being compared BEFORE caching
#   - on a wide table this is the single biggest win, since it cuts how much
#   columnar data actually gets read off disk / object storage.
# - Uses xxhash64() + groupBy instead of a full self-join. xxhash64 is a
#   non-cryptographic hash built for exactly this kind of high-throughput
#   fingerprinting - it's substantially cheaper per row than sha2(), and we
#   don't need cryptographic collision-resistance for a duplicate check.
# - total_count, duplicate_group_count and duplicate_row_count are all
#   computed in ONE aggregation action over the (small, already-shuffled)
#   grouped dataframe, instead of three separate actions.
# - The sample of duplicate rows is fetched by pulling a handful of
#   duplicate keys to the driver and filtering with isin(), NOT by shuffle-
#   joining the full grouped result back onto the raw data.
# - Filters (time window) are applied BEFORE projection/hashing so predicate
#   pushdown / partition pruning kicks in on Delta tables. For daily runs at
#   this volume, make sure the source Delta table is partitioned or
#   Z-ORDERed on the filter_timestamp column - pushdown can only skip files
#   it doesn't have to, it can't skip files that aren't clustered by date.
# =============================================================================

from pyspark.sql import SparkSession
from pyspark.sql import functions as F
from pyspark.sql.types import (
    StructType, StructField, StringType, LongType, DoubleType
)
from datetime import datetime, timedelta
import time
import traceback
import uuid

spark = SparkSession.builder.appName("DuplicateCheckFramework").getOrCreate()

# NOTE: no spark.conf.set(...) calls here on purpose. Serverless compute
# (Databricks Serverless SQL/Jobs) locks down most spark.sql.* confs
# (adaptive execution, shuffle partitions, etc. are already managed for you
# and setting them raises "configuration ... is not available"). The
# hash+groupBy approach below is written to perform well under serverless
# defaults without needing manual tuning.

# ---------------------------------------------------------------------------
# CONFIG - adjust these
# ---------------------------------------------------------------------------

# Fully qualified name of your control table
CONTROL_TABLE = "core_bld.default.radarlivetableinput"

# Layers that get the special "exact payload duplicate" check instead of the
# generic exclude-column check. payload (string) + headers (map<string,string>)
# are present on landing, bronze, and pricingviews tables.
PAYLOAD_DEDUP_LAYERS = {"landing", "bronze", "pricingviews"}

# Per-table extras for the payload check: these tables get an ADDITIONAL
# column folded into the payload duplicate key, on top of the standard
# headers['messageType'] + headers['MQSQuoteId']. Keyed by Tablename_Prod,
# lowercased (matched case-insensitively against the control table's value).
EXTRA_PAYLOAD_KEY_COLUMNS = {
    "dlt_rating_response_uw_results": ["TierName"],
    "vw_rating_response_uw_results": ["TierName"],
}

# Global fallback date range. TESTING: currently set to the last 10 days
# (today-10 through yesterday, full days) so a test run has enough volume
# to look at. Revert to a single day (or None/None for a full scan) once
# testing is done - see the two lines below.
_window_days = 10
_start_date_str = (datetime.now() - timedelta(days=_window_days)).strftime("%Y-%m-%d")
_end_date_str = (datetime.now() - timedelta(days=1)).strftime("%Y-%m-%d")
DEFAULT_START_DT = f"{_start_date_str} 00:00:00.000000"
DEFAULT_END_DT = f"{_end_date_str} 23:59:59.999999"

# Layer-wise filter for this run. Leave [] to run every layer marked Y.
# e.g. ["bronze", "silverish"]
LAYER_FILTER = ["landing", "bronze"]

# Where the run summary gets appended
RESULT_TABLE = "core_bld.default.radar_duplicate_check_results"

# How many calendar days of run history to keep in RESULT_TABLE.
RETENTION_DAYS = 3

# How many example duplicate keys to pull back per table (kept small on purpose)
SAMPLE_LIMIT = 20

# Explicit schema for the summary output. createDataFrame() can't infer a
# type for a column that is None across every row (e.g. 'error' when nothing
# failed), so we spell it out instead of relying on inference.
RESULT_SCHEMA = StructType([
    StructField("Layer", StringType(), True),
    StructField("messagetype", StringType(), True),
    StructField("table", StringType(), True),
    StructField("status", StringType(), True),
    StructField("check_type", StringType(), True),
    StructField("columns_checked", StringType(), True),
    StructField("duplicate_check_sql", StringType(), True),
    StructField("period_checked", StringType(), True),
    StructField("total_count", LongType(), True),
    StructField("duplicate_group_count", LongType(), True),
    StructField("duplicate_row_count", LongType(), True),
    StructField("duplicate_pct", DoubleType(), True),
    StructField("runtime_sec", DoubleType(), True),
    StructField("error", StringType(), True),
    StructField("run_id", StringType(), True),
    StructField("run_date", StringType(), True),
    StructField("is_latest_run", StringType(), True),
])


# ---------------------------------------------------------------------------
# CONTROL TABLE HELPERS
# ---------------------------------------------------------------------------

def get_control_rows(layer_filter=None):
    df = spark.table(CONTROL_TABLE).filter(F.col("include") == "Y")
    if layer_filter:
        df = df.filter(F.col("Layer").isin(layer_filter))
    return df.collect()


def resolve_table_name(row):
    catalog = (row["catalog_prd"] or "").strip()
    schema = (row["Schema"] or "").strip()
    table = (row["Tablename_Prod"] or "").strip()
    parts = [p for p in (catalog, schema, table) if p]
    return ".".join(parts)


def find_column(df, name):
    """
    Case-insensitive column lookup. The same logical column can be spelled
    'Payload' in one table and 'PAYLOAD' in another (or 'filter_timestamp'
    values may not match the actual column's case) - this resolves the
    control table's given name to whatever case that specific table
    actually uses. Returns None if no match.
    """
    if not name:
        return None
    target = name.strip().lower()
    for c in df.columns:
        if c.lower() == target:
            return c
    return None


def get_comparison_columns(df, exclude_col_str):
    """
    All columns of df, minus whatever is listed in exclude_column (comma
    separated). Matching is case-insensitive for the same reason as
    find_column() above - exclude_column entries may not match the actual
    column casing in every table.
    """
    excluded_lower = set()
    if exclude_col_str:
        excluded_lower = {c.strip().lower() for c in exclude_col_str.split(",") if c.strip()}
    return [c for c in df.columns if c.lower() not in excluded_lower]


def apply_time_filter(df, filter_col, start_dt, end_dt):
    """
    Filters df on filter_col between start_dt/end_dt when both are supplied.
    filter_col is resolved case-insensitively against df's actual columns.
    Falls back to a FULL scan (no filter) when the column or the bounds
    are missing.
    Returns (filtered_df, period_label_for_reporting, actual_column_name_or_None)
    """
    actual_col = find_column(df, filter_col)
    if not actual_col:
        return df, "FULL (no filter_timestamp column found on this table)", None

    if not start_dt or not end_dt:
        return df, "FULL (no start/end date available)", actual_col

    filtered = df.filter(
        (F.col(actual_col) >= F.lit(start_dt)) & (F.col(actual_col) <= F.lit(end_dt))
    )
    return filtered, f"{start_dt} to {end_dt}  (on column '{actual_col}')", actual_col


def build_readable_sql(table_name, columns_list, filter_col, start_dt, end_dt, filter_applied):
    """
    Builds a plain, human-readable SELECT statement showing exactly which
    columns were compared for the duplicate check and which filter window
    was applied - for sharing with others, NOT executed anywhere in this
    script.
    """
    select_cols = ", ".join(columns_list)
    sql = f"SELECT {select_cols} FROM {table_name}"
    if filter_applied and filter_col and start_dt and end_dt:
        sql += f" WHERE {filter_col} BETWEEN '{start_dt}' AND '{end_dt}'"
    return sql


# ---------------------------------------------------------------------------
# DUPLICATE CHECK LOGIC
# ---------------------------------------------------------------------------

def _grouped_stats(grouped_df, count_col="_cnt"):
    """
    Single-pass aggregation over an already-grouped (small) dataframe to get
    total row count, duplicate group count and duplicate row count in ONE
    action - instead of calling .count() / .agg(sum) separately, which
    forces Spark to re-read the shuffle output multiple times.
    """
    stats = grouped_df.agg(
        F.sum(count_col).alias("total_count"),
        F.sum(F.when(F.col(count_col) > 1, 1).otherwise(0)).alias("dup_group_count"),
        F.sum(F.when(F.col(count_col) > 1, F.col(count_col)).otherwise(0)).alias("dup_row_count"),
    ).collect()[0]
    return (
        int(stats["total_count"] or 0),
        int(stats["dup_group_count"] or 0),
        int(stats["dup_row_count"] or 0),
    )


def run_standard_dup_check(df, comparison_cols):
    """
    Generic check: project down to ONLY the comparison columns, hash them
    together, group by the hash. Only the small, hash-reduced `grouped`
    result gets cached - never the raw comparison columns themselves, since
    those can carry large text (e.g. a payload column) that blows up memory
    at multi-million-row volumes for no benefit (it's only read once anyway).
    """
    hash_expr = F.xxhash64(
        *[F.coalesce(F.col(c).cast("string"), F.lit("~NULL~")) for c in comparison_cols]
    )
    hashed = df.select(*comparison_cols).withColumn("_dup_hash", hash_expr)
    grouped = hashed.groupBy("_dup_hash").agg(F.count(F.lit(1)).alias("_cnt")).cache()
    try:
        total_count, dup_group_count, dup_row_count = _grouped_stats(grouped)

        sample = df.select(*comparison_cols).limit(0)
        if dup_group_count:
            # pull a handful of duplicate hash keys to the driver, then do a
            # SECOND targeted pass over the (uncached) source to fetch the
            # sample rows - trades one extra lightweight scan for not
            # holding the full raw data in memory.
            dup_hashes = [
                r["_dup_hash"]
                for r in grouped.filter(F.col("_cnt") > 1).select("_dup_hash").limit(SAMPLE_LIMIT).collect()
            ]
            if dup_hashes:
                sample = (
                    df.select(*comparison_cols)
                    .withColumn("_dup_hash", hash_expr)
                    .filter(F.col("_dup_hash").isin(dup_hashes))
                    .select(*comparison_cols)
                    .limit(SAMPLE_LIMIT)
                )
        return total_count, dup_group_count, dup_row_count, sample
    finally:
        grouped.unpersist()


def run_payload_dup_check(df, extra_key_cols=None):
    """
    Special check for landing / bronze / pricingviews layers:
    exact duplicate on `Payload`, keyed by headers['messageType'],
    headers['MQSQuoteId'], and optionally extra_key_cols - additional
    columns (already resolved to their actual case by the caller) folded
    into the duplicate key for specific tables. Assumes `headers` is a
    map<string,string> column.

    Only the grouped (hash + count) result is cached - the raw `Payload`
    text is never cached, since caching the full payload column at
    multi-million-row volumes is what actually causes memory pressure, not
    the (small, capped) sample step.
    """
    extra_key_cols = extra_key_cols or []
    # Alias each extra key column to a safe, string-cast version - VARIANT
    # columns (e.g. TierName can be one) aren't directly usable in groupBy,
    # so we cast to string first. This is harmless for already-string cols.
    extra_key_aliases = [f"_key_{i}" for i in range(len(extra_key_cols))]

    payload_col = find_column(df, "Payload")
    headers_col = find_column(df, "headers")
    if not payload_col or not headers_col:
        raise ValueError(
            f"Expected columns like 'Payload' and 'headers' (case-insensitive), "
            f"but table has {df.columns}"
        )

    def _with_keys(d):
        base = d.select(headers_col, payload_col, *extra_key_cols)
        for src_col, alias in zip(extra_key_cols, extra_key_aliases):
            base = base.withColumn(alias, F.col(src_col).cast("string"))
        base = (
            base.withColumn("_msg_type", F.col(headers_col).getItem("messageType"))
                .withColumn("_quote_id", F.col(headers_col).getItem("MQSQuoteId"))
                .withColumn("_payload_hash", F.xxhash64(F.col(payload_col).cast("string")))
        )
        return base

    working = _with_keys(df)
    group_cols = ["_msg_type", "_quote_id"] + extra_key_aliases + ["_payload_hash"]
    grouped = working.groupBy(*group_cols).agg(F.count(F.lit(1)).alias("_cnt")).cache()
    try:
        total_count, dup_group_count, dup_row_count = _grouped_stats(grouped)

        sample = grouped.filter(F.col("_cnt") > 1).select(*group_cols, "_cnt")
        for alias, orig in zip(extra_key_aliases, extra_key_cols):
            sample = sample.withColumnRenamed(alias, orig)
        sample = sample.limit(SAMPLE_LIMIT)
        return total_count, dup_group_count, dup_row_count, sample
    finally:
        grouped.unpersist()


# ---------------------------------------------------------------------------
# PER-TABLE RUNNER
# ---------------------------------------------------------------------------

def check_table(row):
    result = {
        "Layer": row["Layer"],
        "messagetype": row["messagetype"],
        "table": None,
        "status": "SUCCESS",
        "check_type": None,
        "columns_checked": None,
        "duplicate_check_sql": None,
        "period_checked": None,
        "total_count": None,
        "duplicate_group_count": None,
        "duplicate_row_count": None,
        "duplicate_pct": None,
        "runtime_sec": 0.0,
        "error": None,
    }
    sample = None
    t0 = time.time()
    try:
        full_table_name = resolve_table_name(row)
        result["table"] = full_table_name
        if not full_table_name:
            raise ValueError("catalog_prd / Schema / Tablename_Prod missing in control row")

        df = spark.table(full_table_name)

        # Script-level default (yesterday) takes priority when set; if you
        # clear DEFAULT_START_DT/DEFAULT_END_DT (set both to None), this
        # falls back to the control table's own startdt/enddt for that row.
        start_dt = DEFAULT_START_DT if DEFAULT_START_DT else row["startdt"]
        end_dt = DEFAULT_END_DT if DEFAULT_END_DT else row["enddt"]

        filtered_df, period_label, actual_filter_col = apply_time_filter(
            df, row["filter_timestamp"], start_dt, end_dt
        )
        filter_applied = not period_label.startswith("FULL")

        # STEP 1: count + display the filtered row count BEFORE running the
        # (much more expensive) duplicate comparison. This is a cheap,
        # metadata-friendly action on Delta/Parquet, gives an early sanity
        # check on volume, and leaves a checkpoint in the logs even if the
        # dedup step itself fails or Spark dies partway through the run.
        pre_check_count = filtered_df.count()
        print(f"    Period checked : {period_label}")
        print(f"    Rows in scope  : {pre_check_count}")

        layer = (row["Layer"] or "").strip().lower()
        payload_col = find_column(filtered_df, "Payload")
        headers_col = find_column(filtered_df, "headers")
        payload_cols_present = bool(payload_col and headers_col)

        if layer in PAYLOAD_DEDUP_LAYERS and payload_cols_present:
            # Resolve any per-table extra key columns (e.g. TierName) to
            # their actual case on this table; skip gracefully if missing.
            table_key = (row["Tablename_Prod"] or "").strip().lower()
            extra_cols_wanted = EXTRA_PAYLOAD_KEY_COLUMNS.get(table_key, [])
            resolved_extra_cols = []
            for c in extra_cols_wanted:
                actual = find_column(filtered_df, c)
                if actual:
                    resolved_extra_cols.append(actual)
                else:
                    print(f"    NOTE: extra key column '{c}' not found on {full_table_name} "
                          f"(has {filtered_df.columns}); skipping it for this table's payload check.")

            total_count, dup_group_count, dup_row_count, sample = run_payload_dup_check(
                filtered_df, extra_key_cols=resolved_extra_cols
            )
            extra_label = "".join(f" + {c}" for c in resolved_extra_cols)
            check_type = f"payload_exact_dup (headers.messageType + headers.MQSQuoteId{extra_label})"
            sql_columns = (
                [f"{headers_col}['messageType']", f"{headers_col}['MQSQuoteId']"]
                + resolved_extra_cols
                + [payload_col]
            )
            columns_checked = ",".join(sql_columns)
        else:
            if layer in PAYLOAD_DEDUP_LAYERS and not payload_cols_present:
                # This table is flagged for the payload-based check but its
                # actual schema doesn't have payload/headers (in any case) -
                # fall back to the standard exclude-column check instead of
                # failing the whole table outright.
                print(f"    NOTE: {full_table_name} has no 'Payload'/'headers' columns "
                      f"(has {filtered_df.columns}). Falling back to the standard "
                      f"exclude-column duplicate check for this table.")
            comparison_cols = get_comparison_columns(filtered_df, row["exclude_column"])
            total_count, dup_group_count, dup_row_count, sample = run_standard_dup_check(
                filtered_df, comparison_cols
            )
            check_type = f"full_row_dup (compared {len(comparison_cols)} cols, excluded rest)"
            sql_columns = comparison_cols
            columns_checked = ",".join(comparison_cols)

        duplicate_check_sql = build_readable_sql(
            full_table_name, sql_columns, actual_filter_col, start_dt, end_dt, filter_applied
        )

        result.update({
            "check_type": check_type,
            "columns_checked": columns_checked,
            "duplicate_check_sql": duplicate_check_sql,
            "period_checked": period_label,
            "total_count": total_count,
            "duplicate_group_count": dup_group_count,
            "duplicate_row_count": dup_row_count,
            "duplicate_pct": round((dup_row_count / total_count) * 100, 4) if total_count else 0.0,
        })

    except Exception as e:
        result["status"] = "FAILED"
        result["error"] = str(e)
        traceback.print_exc()

    result["runtime_sec"] = round(time.time() - t0, 2)
    return result, sample


def _print_result(r):
    print(f"Status            : {r['status']}")
    if r["status"] == "FAILED":
        print(f"Error             : {r['error']}")
        print(f"Runtime (sec)     : {r['runtime_sec']}")
        return
    print(f"Check type        : {r['check_type']}")
    print(f"Columns checked   : {r['columns_checked']}")
    print(f"Shareable SQL     : {r['duplicate_check_sql']}")
    print(f"Period checked    : {r['period_checked']}")
    print(f"Total rows        : {r['total_count']}")
    print(f"Duplicate groups  : {r['duplicate_group_count']}")
    print(f"Duplicate rows    : {r['duplicate_row_count']}")
    print(f"Duplicate %       : {r['duplicate_pct']}%")
    print(f"Runtime (sec)     : {r['runtime_sec']}")


# ---------------------------------------------------------------------------
# MAIN ENTRY POINT
# ---------------------------------------------------------------------------

def _finalize_run(run_id, run_date, touched_tables):
    """
    After a run completes:
    1. Marks any EARLIER rows for the SAME tables on the SAME run_date
       (different run_id) as no longer the latest run.
    2. Purges result rows older than RETENTION_DAYS calendar days.
    """
    if touched_tables:
        table_list_sql = ", ".join("'" + t.replace("'", "''") + "'" for t in touched_tables)
        spark.sql(f"""
            UPDATE {RESULT_TABLE}
            SET is_latest_run = 'N'
            WHERE run_date = '{run_date}'
              AND run_id <> '{run_id}'
              AND table IN ({table_list_sql})
        """)

    cutoff_date = (datetime.now() - timedelta(days=RETENTION_DAYS - 1)).strftime("%Y-%m-%d")
    spark.sql(f"DELETE FROM {RESULT_TABLE} WHERE run_date < '{cutoff_date}'")
    print(f"Retention: kept run_date >= {cutoff_date} ({RETENTION_DAYS} day(s)) in {RESULT_TABLE}")


def run_all(layer_filter=None, write_results=True):
    layer_filter = layer_filter or LAYER_FILTER or None

    # Safety net: release anything left cached in memory by a prior
    # partial/crashed run before this one starts.
    spark.catalog.clearCache()

    run_id = str(uuid.uuid4())
    run_date = datetime.now().strftime("%Y-%m-%d")

    control_rows = get_control_rows(layer_filter)
    print(f"Found {len(control_rows)} table(s) with include='Y'"
          + (f" for layer(s) {layer_filter}" if layer_filter else " across all layers"))
    print(f"Run ID: {run_id}  |  Run date: {run_date}")

    results = []
    samples = {}
    for row in control_rows:
        table_name = resolve_table_name(row)
        print(f"\n--- Checking [{row['Layer']}] {table_name} ---")
        res, sample = check_table(row)
        res["run_id"] = run_id
        res["run_date"] = run_date
        res["is_latest_run"] = "Y"
        results.append(res)
        samples[table_name] = sample
        _print_result(res)

        if write_results:
            # Write THIS table's result the moment it's ready, instead of
            # batching everything and writing once at the end. If Spark
            # dies on table 40 of 100, tables 1-39 are already saved and
            # you don't lose the whole run's progress.
            row_df = spark.createDataFrame([res], schema=RESULT_SCHEMA)
            row_df.write.mode("append").saveAsTable(RESULT_TABLE)

    summary_df = spark.createDataFrame(results, schema=RESULT_SCHEMA)

    if write_results:
        touched_tables = [r["table"] for r in results if r.get("table")]
        _finalize_run(run_id, run_date, touched_tables)
        print(f"All results appended incrementally to {RESULT_TABLE}")

    try:
        display(summary_df)  # noqa: F821  - Databricks notebook display()
    except NameError:
        summary_df.show(truncate=False)

    return summary_df, samples


if __name__ == "__main__":
    run_all()
