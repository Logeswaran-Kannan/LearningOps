WITH base AS (
    SELECT
        DATE(enqueuedTime) AS enqueue_date,
        enqueuedTime,
        headers['MQSQuoteId'] AS mqs_quote_id,
        headers['messageType'] AS message_type,
        headers['quoteStep'] AS quote_step,
        TO_DATE(headers['quoteDate']) AS quote_date
    FROM core.mqs_athn_mtr.ehubstream
    WHERE headers['quoteDate'] IS NOT NULL
      AND headers['MQSQuoteId'] IS NOT NULL
)

SELECT
    enqueue_date,
    COUNT(*) AS total_messages,

    SUM(CASE
        WHEN DATEDIFF(enqueue_date, quote_date) = 0 THEN 1 ELSE 0
    END) AS same_day,

    SUM(CASE
        WHEN DATEDIFF(enqueue_date, quote_date) = 1 THEN 1 ELSE 0
    END) AS one_day_late,

    SUM(CASE
        WHEN DATEDIFF(enqueue_date, quote_date) = 2 THEN 1 ELSE 0
    END) AS two_days_late,

    SUM(CASE
        WHEN DATEDIFF(enqueue_date, quote_date) >= 3 THEN 1 ELSE 0
    END) AS three_plus_days_late,

    ROUND(
        100.0 * SUM(
            CASE WHEN DATEDIFF(enqueue_date, quote_date) > 0 THEN 1 ELSE 0 END
        ) / COUNT(*),
        4
    ) AS delayed_pct

FROM base
GROUP BY enqueue_date
ORDER BY enqueue_date;

