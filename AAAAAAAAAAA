
from pyspark.sql import functions as F
from pyspark.sql import Window

spark.conf.set("spark.sql.shuffle.partitions", "200")

SOURCE = "core.mqs_athn_mtr.ehubstream"
START_DATE = "2026-05-05"

# 1. Read required data
df = (
    spark.table(SOURCE)
    .where(F.col("enqueuedTime") >= F.lit(START_DATE))
    .select(
        "enqueuedTime",
        F.to_date("enqueuedTime").alias("event_date"),
        F.col("headers")["messageType"].alias("messageType"),
        F.col("headers")["externalID"].alias("externalID"),
        F.col("headers")["MQSQuoteId"].alias("MQSQuoteId"),
        F.col("headers")["quoteStep"].alias("quoteStep"),
        "headers",
        F.col("payload").cast("string").alias("payload")
    )
)

# 2. Hash original duplicate combination
# Two hashes reduce accidental collision risk.
headers_json = F.to_json("headers")

df = df.withColumn(
    "duplicate_key",
    F.sha2(
        F.to_json(
            F.struct(
                "enqueuedTime",
                "messageType",
                "externalID",
                "MQSQuoteId",
                "quoteStep",
                headers_json.alias("headers_json"),
                "payload"
            ),
            {"ignoreNullFields": "false"}
        ),
        256
    )
).select(
    "event_date",
    "duplicate_key",
    "MQSQuoteId",
    "messageType",
    "externalID",
    "quoteStep"
)

# 3. Count occurrences per duplicate combination
combinations = (
    df.groupBy(
        "event_date",
        "duplicate_key"
    )
    .agg(
        F.count("*").alias("occurrences"),
        F.first("MQSQuoteId", ignorenulls=True).alias("MQSQuoteId"),
        F.first("messageType", ignorenulls=True).alias("messageType"),
        F.first("externalID", ignorenulls=True).alias("externalID"),
        F.first("quoteStep", ignorenulls=True).alias("quoteStep")
    )
    .withColumn(
        "duplicate_records",
        F.col("occurrences") - 1
    )
)

# 4. Daily trend
daily_trend = (
    combinations
    .groupBy("event_date")
    .agg(
        F.sum("occurrences").alias("total_records"),
        F.sum("duplicate_records").alias("duplicate_records"),
        F.sum(
            F.when(F.col("occurrences") > 1, 1).otherwise(0)
        ).alias("duplicate_combinations")
    )
    .withColumn(
        "duplicate_pct",
        F.round(
            F.col("duplicate_records") /
            F.col("total_records") * 100, 3
        )
    )
)

# 5. Overall summary
summary = daily_trend.agg(
    F.sum("total_records").alias("total_records"),
    F.sum("duplicate_records").alias("duplicate_records"),
    F.sum("duplicate_combinations").alias("duplicate_combinations")
).withColumn(
    "duplicate_pct",
    F.round(
        F.col("duplicate_records") /
        F.col("total_records") * 100, 3
    )
)

print("OVERALL DUPLICATE SUMMARY")
display(summary)

print("DAILY DUPLICATE TREND")
display(daily_trend.orderBy("event_date"))

print("TOP 50 DUPLICATE COMBINATIONS")
display(
    combinations
    .filter(F.col("occurrences") > 1)
    .orderBy(F.desc("occurrences"))
    .limit(50)
)
