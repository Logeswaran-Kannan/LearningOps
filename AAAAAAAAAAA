WITH base AS (
    SELECT
        DATE(enqueuedTime) AS enqueue_date,
        enqueuedTime,
        headers['MQSQuoteId'] AS mqs_quote_id,
        headers['messageType'] AS message_type,
        headers['quoteStep'] AS quote_step,
        TO_DATE(headers['quoteDate']) AS quote_date,

        COUNT(*) OVER (
            PARTITION BY
                headers['MQSQuoteId'],
                headers['messageType']
        ) AS occurrence_count

    FROM core.mqs_athn_mtr.ehubstream
    WHERE headers['MQSQuoteId'] IS NOT NULL
),

daily AS (
    SELECT
        enqueue_date,

        COUNT(*) AS total_messages,

        SUM(
            CASE WHEN occurrence_count > 1
            THEN 1 ELSE 0 END
        ) AS repeated_message_candidates,

        SUM(
            CASE
                WHEN DATEDIFF(enqueue_date, quote_date) > 0
                THEN 1 ELSE 0
            END
        ) AS delayed_messages,

        SUM(
            CASE
                WHEN occurrence_count > 1
                 AND DATEDIFF(enqueue_date, quote_date) > 0
                THEN 1 ELSE 0
            END
        ) AS delayed_and_repeated

    FROM base
    GROUP BY enqueue_date
)

SELECT *,
    ROUND(
        100.0 * delayed_and_repeated / total_messages,
        4
    ) AS suspected_replay_pct

FROM daily
ORDER BY enqueue_date;
