      format_only_rows BIGINT COMMENT 'Rows that match only after normalisation (format issues)',
      src_only_rows BIGINT COMMENT 'Source rows with no full-record match in target',
      tgt_only_rows BIGINT COMMENT 'Target rows with no full-record match in source',
