# ============================================================
# READ DEV EVENT HUB FROM START OF CURRENT DAY
#
# Read-only:
# - No Delta table write
# - No permanent checkpoint
# - No changes to the existing development ingestion code
# - Reads historical messages from 00:00 today plus new messages
# ============================================================

from pyspark.sql.functions import (
    col,
    current_timestamp,
    expr
)

# ------------------------------------------------------------
# 1. Confirm that the notebook is running in DEV
# ------------------------------------------------------------

catalog = spark.sql("SELECT current_catalog()").collect()[0][0]

if catalog != "core_bld":
    raise ValueError(
        f"This script is intended only for DEV catalog 'core_bld'. "
        f"Current catalog is '{catalog}'."
    )

# ------------------------------------------------------------
# 2. DEV Event Hub configuration
# ------------------------------------------------------------

eventhub_connection_string = dbutils.secrets.get(
    scope="Azure-secret-key-vault",
    key="pts-mqs-bicoe-eventhub"
)

eventhub_topic = "mqs-bicoe-pts"
eventhub_namespace = "ap-pric-npd-uks-evhn-001"

bootstrap_servers = (
    f"{eventhub_namespace}.servicebus.windows.net:9093"
)

sasl_config = (
    "kafkashaded.org.apache.kafka.common.security.plain."
    "PlainLoginModule required "
    'username="$ConnectionString" '
    f'password="{eventhub_connection_string}";'
)

# ------------------------------------------------------------
# 3. Calculate today's start time as Unix epoch milliseconds
#
# This uses the Databricks/Spark session timezone.
# Example:
# 2026-08-03 00:00:00 -> epoch milliseconds
# ------------------------------------------------------------

starting_timestamp = spark.sql(
    """
    SELECT CAST(
        unix_timestamp(date_trunc('DAY', current_timestamp())) * 1000
        AS STRING
    ) AS starting_timestamp
    """
).collect()[0]["starting_timestamp"]

start_of_day_readable = spark.sql(
    """
    SELECT date_trunc('DAY', current_timestamp()) AS start_of_day
    """
).collect()[0]["start_of_day"]

print(f"Current catalog     : {catalog}")
print(f"Event Hub topic     : {eventhub_topic}")
print(f"Reading messages from: {start_of_day_readable}")
print(f"Starting timestamp  : {starting_timestamp}")

# ------------------------------------------------------------
# 4. Read Event Hub from the beginning of today
# ------------------------------------------------------------

raw_eventhub_df = (
    spark.readStream
    .format("kafka")
    .option("kafka.bootstrap.servers", bootstrap_servers)
    .option("subscribe", eventhub_topic)
    .option("kafka.sasl.mechanism", "PLAIN")
    .option("kafka.security.protocol", "SASL_SSL")
    .option("kafka.sasl.jaas.config", sasl_config)
    .option("startingTimestamp", starting_timestamp)
    .option("includeHeaders", "true")
    .option("failOnDataLoss", "false")
    .load()
)

# ------------------------------------------------------------
# 5. Convert payload and headers into readable format
# ------------------------------------------------------------

readable_eventhub_df = (
    raw_eventhub_df
    .withColumnRenamed("timestamp", "enqueuedTime")
    .withColumn(
        "headers",
        expr(
            """
            map_from_entries(
                transform(
                    headers,
                    header -> struct(
                        header.key,
                        regexp_replace(
                            CAST(header.value AS STRING),
                            '[^a-zA-Z0-9_@.:-]',
                            ''
                        )
                    )
                )
            )
            """
        )
    )
    .select(
        col("enqueuedTime"),
        col("partition"),
        col("offset").cast("long").alias("offset"),
        col("key").cast("string").alias("messageKey"),
        col("headers"),
        col("value").cast("string").alias("payload"),
        current_timestamp().alias("readTimestamp")
    )
    .orderBy(
        col("enqueuedTime").desc(),
        col("partition"),
        col("offset").desc()
    )
)

# ------------------------------------------------------------
# 6. Display historical messages from today and new messages
#
# Stop the stream manually after completing the investigation.
# ------------------------------------------------------------

display(readable_eventhub_df)
