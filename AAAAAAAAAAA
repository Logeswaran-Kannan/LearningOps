DROP TABLE IF EXISTS tmp_table_counts;

CREATE TEMP TABLE tmp_table_counts
(
    table_name      text,
    filter_column   text,
    count_type      text,
    record_count    bigint
);

DO $$
DECLARE
    v_table      text;
    v_schema     text := 'public';   -- CHANGE SCHEMA IF REQUIRED
    v_column     text;
    v_count      bigint;

    -- ADD YOUR TABLE NAMES HERE
    v_tables text[] := ARRAY[
        'table1',
        'table2',
        'table3',
        'table4'
    ];

BEGIN

    FOREACH v_table IN ARRAY v_tables
    LOOP

        v_column := NULL;
        v_count  := 0;

        /*
        -------------------------------------------------------
        1. Check for updatetime column
        -------------------------------------------------------
        */
        SELECT column_name
        INTO v_column
        FROM information_schema.columns
        WHERE table_schema = v_schema
          AND table_name = v_table
          AND lower(column_name) = 'updatetime'
        LIMIT 1;


        /*
        -------------------------------------------------------
        2. If updatetime does not exist, check createtime
        -------------------------------------------------------
        */
        IF v_column IS NULL THEN

            SELECT column_name
            INTO v_column
            FROM information_schema.columns
            WHERE table_schema = v_schema
              AND table_name = v_table
              AND lower(column_name) = 'createtime'
            LIMIT 1;

        END IF;


        /*
        -------------------------------------------------------
        3. Timestamp column available
        -------------------------------------------------------
        */
        IF v_column IS NOT NULL THEN

            EXECUTE format(
                'SELECT count(*)
                   FROM %I.%I
                  WHERE %I >= timestamp %L
                    AND %I <  timestamp %L',
                v_schema,
                v_table,
                v_column,
                '2026-08-16 03:00:00',
                v_column,
                '2026-08-17 03:00:00'
            )
            INTO v_count;

            INSERT INTO tmp_table_counts
            VALUES
            (
                v_table,
                v_column,
                'DATE_FILTERED',
                v_count
            );


        /*
        -------------------------------------------------------
        4. No updatetime / createtime - full count
        -------------------------------------------------------
        */
        ELSE

            EXECUTE format(
                'SELECT count(*) FROM %I.%I',
                v_schema,
                v_table
            )
            INTO v_count;

            INSERT INTO tmp_table_counts
            VALUES
            (
                v_table,
                NULL,
                'FULL_COUNT',
                v_count
            );

        END IF;

    END LOOP;

END $$;


/*
-----------------------------------------------------------
Final Result
-----------------------------------------------------------
*/
SELECT
    table_name,
    filter_column,
    count_type,
    record_count
FROM tmp_table_counts
ORDER BY table_name;
