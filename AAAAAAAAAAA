# ==============================================================
# SIZE GUARD — Teams hard limit is ~28,672 bytes
# ==============================================================
TEAMS_MAX_BYTES = 26000

def payload_size(payload) -> int:
    return len(json.dumps(payload).encode("utf-8"))

def enforce_size_limit(payload, max_bytes=TEAMS_MAX_BYTES, dashboard_url=None):
    size = payload_size(payload)
    if size <= max_bytes:
        return payload, size

    print(f"  Card size {size} bytes exceeds {max_bytes} — trimming detail rows")
    body = payload["attachments"][0]["content"]["body"]

    trimmed = [b for b in body if b.get("type") != "ColumnSet"]
    trimmed.append({
        "type": "TextBlock",
        "text": "⚠ Full per-flow breakdown omitted — payload too large for Teams. See dashboard for details.",
        "wrap": True, "size": "Small", "isSubtle": True
    })
    payload["attachments"][0]["content"]["body"] = trimmed
    size = payload_size(payload)
    if size <= max_bytes:
        print(f"  Trimmed to {size} bytes — OK")
        return payload, size

    print(f"  Still {size} bytes after trim — collapsing to summary only")
    header = next((b for b in body if b.get("type") == "Container"), body[0])
    minimal = [
        header,
        {
            "type": "TextBlock",
            "text": "⚠ Alert details omitted — payload exceeded Teams size limit even after trimming. Check the dashboard.",
            "wrap": True, "size": "Small", "isSubtle": True
        }
    ]
    if dashboard_url:
        minimal.append({
            "type": "TextBlock",
            "text": f"Dashboard: {dashboard_url}",
            "wrap": True, "size": "Small", "isSubtle": True
        })
    payload["attachments"][0]["content"]["body"] = minimal
    size = payload_size(payload)
    print(f"  Final size: {size} bytes")
    return payload, size
